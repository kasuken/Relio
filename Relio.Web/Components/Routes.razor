@* AuthorizeRouteView re-checks authorization on every in-circuit client-side navigation (not just
   the initial HTTP request, which the fallback authorization policy in
   Relio.Web.Identity.ServiceCollectionExtensions.AddRelioIdentity already redirects to
   /Account/Login for) - e.g. a session expiring while the circuit is still open. See AGENTS.md
   "Protect app pages". *@
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @* Signed in but not allowed (e.g. a non-administrator on /admin/users) is "access
                   denied"; sending them to the login page would be wrong and confusing. *@
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <RedirectToAccessDenied />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
