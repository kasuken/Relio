@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout Relio.Web.Components.Account.Shared.AccountLayout

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@using Relio.Data.Identity
@using Relio.Web.Email

@inject UserManager<RelioUser> UserManager
@inject IEmailSender<RelioUser> EmailSender
@inject IOptions<EmailOptions> EmailOptionsAccessor
@inject NavigationManager NavigationManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot your password? - Relio</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-2">Forgot your password?</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
    Enter the email address for your account. If we can match it, we'll send you a link to reset
    your password.
</MudText>

@* Says nothing about whether THIS email is registered - only whether email delivery is
   configured at all on this instance - so it can never be used to test an address. See
   AGENTS.md "Accounts and authentication" for the no-enumeration reasoning this page follows. *@
@if (_emailProviderUnavailable)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" data-testid="forgot-password-unavailable-note">
        Password reset by email isn't available on this Relio instance. Ask your administrator.
    </MudAlert>
}

<EditForm Model="Input" FormName="forgot-password" OnValidSubmit="ForgotPasswordAsync" method="post">
    <DataAnnotationsValidator />

    @* Plain HTML input, not MudTextField - see Register.razor's matching comment: MudBlazor's
       inputs need a live circuit to post their value, which this static SSR page does not have. *@
    <div class="rl-field">
        <label for="forgot-password-email">Email</label>
        <input id="forgot-password-email" name="Input.Email" type="email" required
               value="@Input!.Email" data-testid="forgot-password-email" />
        <ValidationMessage For="@(() => Input!.Email)" />
    </div>

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
               FullWidth="true" data-testid="forgot-password-submit" Class="mt-2">
        Send reset link
    </MudButton>
</EditForm>

<MudText Typo="Typo.body2" Class="mud-text-secondary mt-6">
    <MudLink Href="/Account/Login">Back to sign in</MudLink>
</MudText>

@code {
    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    private bool _emailProviderUnavailable;

    protected override void OnInitialized()
    {
        Input ??= new();
        _emailProviderUnavailable = !EmailOptionsAccessor.Value.CanSendEmail;
    }

    /// <summary>
    /// Always redirects to the exact same confirmation page with the exact same message,
    /// regardless of whether <see cref="InputModel.Email"/> matches an account, and regardless of
    /// whether that account's email is confirmed - see AGENTS.md "Accounts and authentication" for
    /// why an unconfirmed account can still reset its password. The two branches below also do
    /// near-identical work (both generate a password reset token; only "send the email" differs),
    /// so a timing attack gains nothing a response-content attack couldn't already rule out.
    /// </summary>
    /// <remarks>
    /// TODO(#60): rate-limit repeated requests for the same email/IP - out of scope for #17.
    /// </remarks>
    private async Task ForgotPasswordAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input!.Email);
        if (user is not null)
        {
            var resetLink = await BuildResetLinkAsync(user);

            // NullEmailSender (Email:Provider=None) logs its own "not sending" warning here -
            // never the email address, see its remarks - so self-hosted admins can see that a
            // reset was requested with no provider configured, without this page's response
            // revealing anything about Input.Email to the person who submitted it.
            await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, resetLink);
            Logger.LogInformation("Password reset requested for user {UserId}.", user.Id);
        }
        else
        {
            // No real account to send to - still pay the token-generation cost against a
            // throwaway, never-persisted user (not the SMTP round trip itself, which only a real
            // recipient needs), so this page's response time does not become an
            // account-enumeration oracle alongside the identical on-screen message either way.
            await BuildResetLinkAsync(new RelioUser
            {
                Id = Guid.NewGuid().ToString(),
                SecurityStamp = Guid.NewGuid().ToString(),
            });
            Logger.LogInformation("Password reset requested for an email that does not match any account.");
        }

        NavigationManager.NavigateTo("/Account/ForgotPasswordConfirmation", forceLoad: true);
    }

    private async Task<string> BuildResetLinkAsync(RelioUser user)
    {
        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GeneratePasswordResetTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

        return NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("/Account/ResetPassword").ToString(),
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
