@page "/Account/ForgotPasswordConfirmation"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout Relio.Web.Components.Account.Shared.AccountLayout

<PageTitle>Check your email - Relio</PageTitle>

@* Deliberately the same heading and message every time ForgotPassword.razor redirects here -
   whether or not the submitted email matched an account, and whether or not it was confirmed.
   See AGENTS.md "Accounts and authentication" (no account enumeration). *@
<MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-4" data-testid="forgot-password-confirmation-heading">
    Check your email
</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
    If an account exists for that email address, we've sent a link to reset your password.
</MudText>
<MudLink Href="/Account/Login">Back to sign in</MudLink>
