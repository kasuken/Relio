@page "/Account/Login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout Relio.Web.Components.Account.Shared.AccountLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Relio.Data.Identity
@using Relio.Web.Security

@inject IAccountRegistrationService RegistrationService
@inject SignInManager<RelioUser> SignInManager
@inject UserManager<RelioUser> UserManager
@inject NavigationManager NavigationManager
@inject ILogger<Login> Logger

<PageTitle>Sign in - Relio</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-6">Sign in</MudText>

<EditForm Model="Input" FormName="login" OnValidSubmit="LoginAsync" method="post">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="login-error">@_errorMessage</MudAlert>
    }

    @* Plain HTML inputs, not MudTextField - see Register.razor's matching comment: MudBlazor's
       inputs need a live circuit to post their value, which this static SSR page does not have. *@
    <div class="rl-field">
        <label for="login-email">Email</label>
        <input id="login-email" name="Input.Email" type="email" required
             value="@Input!.Email" data-testid="login-email" />
         <ValidationMessage For="@(() => Input!.Email)" />
    </div>

    <div class="rl-field">
        <label for="login-password">Password</label>
        <input id="login-password" name="Input.Password" type="password" required
               data-testid="login-password" />
        <ValidationMessage For="@(() => Input!.Password)" />
    </div>

    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        <MudLink Href="/Account/ForgotPassword" data-testid="login-forgot-password">Forgot your password?</MudLink>
    </MudText>

    @* A plain HTML checkbox, for the same static-SSR reason the fields above are plain HTML
       (see the matching comment on Register.razor): an unchecked checkbox simply submits
       nothing, which SupplyParameterFromForm leaves at InputModel.RememberMe's default (false) -
       no hidden "false" companion field needed. *@
    <div class="rl-checkbox-field">
        <input id="login-remember-me" name="Input.RememberMe" type="checkbox" value="true"
               data-testid="login-remember-me" />
        <label for="login-remember-me">Remember me</label>
    </div>

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
               FullWidth="true" data-testid="login-submit" Class="mt-2">
        Sign in
    </MudButton>
</EditForm>

@* Hidden when the instance is closed or invitation-only: a link to a page that only says "no" is
   noise, and invited people arrive by their invitation link instead. See Register.razor. *@
@if (_canRegister)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-6">
        @* data-enhance-nav="false": Register.razor fills its hidden time zone field from an inline
           <script>, and Blazor's enhanced navigation (active now that blazor.web.js loads for signed-out
           visitors) does not execute scripts in the patched-in content. A full page load does. *@
        New to Relio? <MudLink Href="/Account/Register" data-enhance-nav="false" data-testid="login-create-account">Create an account</MudLink>
    </MudText>
}

@code {
    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? _errorMessage;
    private bool _canRegister;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        // Static SSR page reached directly (not via client-side Blazor navigation) - clear any
        // lingering external cookie, matching the standard Identity account pages template.
        await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);

        // Only offer "Create an account" when someone without an invitation could actually use it
        // (open sign-up, or the instance's very first account).
        _canRegister = (await RegistrationService.GetEligibilityAsync(null)).CanRegister;
    }

    private async Task LoginAsync()
    {
        // Looked up once, by email, so every branch below can log the user id (never the email -
        // see AGENTS.md "Privacy"/the gdpr-compliant skill) without a second round trip. A
        // not-found account still goes through the exact same error message as a wrong password
        // (see SignInMessages.InvalidCredentials) - only the log line differs, and even that never
        // includes the submitted email.
        var user = await UserManager.FindByEmailAsync(Input!.Email);
        if (user is null)
        {
            Logger.LogInformation("Sign-in failed: no account matches the submitted email.");
            _errorMessage = SignInMessages.InvalidCredentials;
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            user, Input.Password, isPersistent: Input.RememberMe, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Logger.LogInformation("User {UserId} signed in.", user.Id);
            var safeReturnUrl = ReturnUrlValidator.GetSafeReturnUrl(ReturnUrl, NavigationManager.BaseUri);
            NavigationManager.NavigateTo(safeReturnUrl, forceLoad: true);
            return;
        }

        if (result.RequiresTwoFactor)
        {
            // Issue #20. Identity has already written the short-lived "Identity.TwoFactorUserId"
            // cookie; the second step reads the user from it, so nothing about the account travels
            // in the URL. Only the (already validated) return URL and the remember-me choice are
            // handed on - the second step validates the return URL again, as it comes back in a
            // query string anyone can edit.
            Logger.LogInformation("User {UserId} passed the password check; a two-factor code is required.", user.Id);
            var target = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("/Account/LoginWith2fa").ToString(),
                new Dictionary<string, object?>
                {
                    ["returnUrl"] = ReturnUrlValidator.GetSafeReturnUrl(ReturnUrl, NavigationManager.BaseUri),
                    ["rememberMe"] = Input.RememberMe,
                });
            NavigationManager.NavigateTo(target, forceLoad: true);
            return;
        }

        if (result.IsLockedOut)
        {
            Logger.LogWarning("User {UserId} is locked out after repeated failed sign-in attempts.", user.Id);
            _errorMessage = SignInMessages.LockedOut;
            return;
        }

        // Before IsNotAllowed below: RelioSignInResult.Disabled is also "not allowed".
        if (result is RelioSignInResult { IsDisabled: true })
        {
            Logger.LogInformation("User {UserId} tried to sign in to a disabled account.", user.Id);
            _errorMessage = SignInMessages.Disabled;
            return;
        }

        if (result.IsNotAllowed)
        {
            Logger.LogInformation("User {UserId} attempted to sign in before confirming their email.", user.Id);
            _errorMessage = "Confirm your email address before signing in. Check your inbox for the confirmation link.";
            return;
        }

        Logger.LogInformation("User {UserId} submitted an incorrect password.", user.Id);
        _errorMessage = SignInMessages.InvalidCredentials;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;

        /// <summary>
        /// Whether to issue a persistent (survives closing the browser) sign-in cookie rather
        /// than a session-only one. Unset (missing from the form post) when the checkbox is left
        /// unchecked - see the matching comment above the checkbox markup.
        /// </summary>
        public bool RememberMe { get; set; }
    }
}
