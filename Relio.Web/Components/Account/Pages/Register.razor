@page "/Account/Register"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout Relio.Web.Components.Account.Shared.AccountLayout

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Relio.Application.Time
@using Relio.Data.Identity
@using Relio.Web.Security

@inject IAccountRegistrationService RegistrationService
@inject UserManager<RelioUser> UserManager
@inject SignInManager<RelioUser> SignInManager
@inject IEmailSender<RelioUser> EmailSender
@inject NavigationManager NavigationManager
@inject ILogger<Register> Logger

@* Static SSR waits for OnInitializedAsync, so _eligibility is always set by the time this renders. *@
@if (_eligibility is null)
{
}
else if (_eligibility.CanRegister)
{
    <PageTitle>Create your account - Relio</PageTitle>

    <MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-2">Create your account</MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
        Relio is a private notebook about the people in your life. Only you can see what you keep here.
    </MudText>

    @if (_eligibility.Access == RegistrationAccess.FirstAccount)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" data-testid="register-first-account-note">
            You're creating the first account on this Relio instance, so it will also be its administrator.
        </MudAlert>
    }

    <div data-testid="register-form">
        <EditForm Model="Input" FormName="register" OnValidSubmit="RegisterAsync" method="post">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="register-error">@_errorMessage</MudAlert>
            }

            @* Plain HTML inputs, not MudTextField: MudBlazor's inputs only post their value back to the
               server when a live circuit drives their two-way binding, so on this static SSR page (see
               the [ExcludeFromInteractiveRouting] attribute above) they would render with no "name"
               attribute at all and the form post would arrive with the field empty. See ".rl-field" in
               wwwroot/app.css for the styling that keeps these on the same tokens as every other input. *@
            <div class="rl-field @(_errorMessage is not null ? "rl-field-invalid" : null)">
                <label for="register-email">Email</label>
                <input id="register-email" name="Input.Email" type="email" required
                       value="@Input!.Email" readonly="@(_eligibility.InvitedEmail is not null)"
                       data-testid="register-email" />
                @if (_eligibility.InvitedEmail is not null)
                {
                    <span class="rl-field-helper">This invitation is for this address.</span>
                }
                <ValidationMessage For="@(() => Input!.Email)" />
            </div>

            <div class="rl-field">
                <label for="register-password">Password</label>
                <input id="register-password" name="Input.Password" type="password" required
                       data-testid="register-password" />
                <span class="rl-field-helper">At least 12 characters, with upper and lower case, a digit and a symbol.</span>
                <ValidationMessage For="@(() => Input!.Password)" />
            </div>

            <div class="rl-field">
                <label for="register-confirm-password">Confirm password</label>
                <input id="register-confirm-password" name="Input.ConfirmPassword" type="password" required
                       data-testid="register-confirm-password" />
                <ValidationMessage For="@(() => Input!.ConfirmPassword)" />
            </div>

            @* Filled by the self-hosted script below, not Blazor JS interop: this page renders as
               static SSR (see the [ExcludeFromInteractiveRouting] attribute above) so the password can
               be hashed and the sign-in cookie written directly against HttpContext - there is no live
               circuit here for Relio.Web.Time.BrowserTimeZoneReader's JS interop to use. See the "Dates
               and time zones" section of AGENTS.md. *@
            <input type="hidden" name="Input.TimeZoneId" id="register-timezone-input" value="@Input!.TimeZoneId" />

            @* The invitation token travels in a hidden field (not only the query string) so it
               survives a failed attempt, e.g. a password the policy rejects. It is never an email. *@
            <input type="hidden" name="Input.InvitationToken" value="@InvitationToken" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" data-testid="register-submit" Class="mt-2">
                Create account
            </MudButton>
        </EditForm>
    </div>

    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-6">
        Already have an account? <MudLink Href="/Account/Login" data-enhance-nav="false">Sign in</MudLink>
    </MudText>

    <RelioPolicyLinks CssClass="rl-policy-links rl-registration-policy-links"
                      AriaLabel="Policies for this instance" />

    @* A plain, synchronous script - not type="module" importing wwwroot/js/timezone.js: a module
       import is an asynchronous network fetch, which races an automated (or simply fast) form
       submission on this static SSR page. A classic script tag runs synchronously as soon as the
       parser reaches it, i.e. immediately after the hidden input above already exists in the DOM and
       well before any submit can happen, at the cost of duplicating timezone.js's one-line body here. *@
    <script nonce="@ContentSecurityPolicyNonce.Get(HttpContext)">
        (function () {
            var timeZoneInput = document.getElementById('register-timezone-input');
            if (!timeZoneInput) {
                return;
            }
            try {
                timeZoneInput.value = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
            } catch {
                timeZoneInput.value = 'UTC';
            }
        })();
    </script>
}
else
{
    @* Registration is not available: say why, calmly, with no form at all. *@
    <PageTitle>@UnavailableTitle - Relio</PageTitle>

    <div data-testid="@UnavailableTestId">
        <MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-4">@UnavailableTitle</MudText>
        <MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">@UnavailableMessage</MudText>
        <MudLink Href="/Account/Login" data-enhance-nav="false">Sign in</MudLink>
    </div>
}

@code {
    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    [SupplyParameterFromQuery(Name = "invite")]
    private string? Invite { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? _errorMessage;
    private RegistrationEligibility? _eligibility;

    /// <summary>The invitation token in play: the posted one (survives a failed attempt), else the link's.</summary>
    private string? InvitationToken => string.IsNullOrWhiteSpace(Input!.InvitationToken) ? Invite : Input.InvitationToken;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        await RefreshEligibilityAsync();

        if (_eligibility is { InvitedEmail: { } invitedEmail } && string.IsNullOrEmpty(Input.Email))
        {
            Input.Email = invitedEmail;
        }
    }

    private async Task RefreshEligibilityAsync()
    {
        _eligibility = await RegistrationService.GetEligibilityAsync(InvitationToken);
        ApplyStatusCode();
    }

    /// <summary>
    /// A closed instance answers 403 Forbidden with the explanation, so crawlers and scripts see a
    /// refusal rather than a sign-up form. Not 404: Blazor treats a component-set 404 as "not found"
    /// and has the status code pages middleware replace the body with the Not Found page, which
    /// would hide the explanation. Set before any output (static SSR renders after initialization),
    /// and only if the response has not started.
    /// </summary>
    private void ApplyStatusCode()
    {
        if (_eligibility?.Access == RegistrationAccess.Closed && !HttpContext.Response.HasStarted)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
        }
    }

    private string UnavailableTestId => _eligibility?.Access switch
    {
        RegistrationAccess.Closed => "register-closed",
        RegistrationAccess.RequiresInvitation => "register-invite-required",
        _ => "register-invite-invalid",
    };

    private string UnavailableTitle => _eligibility?.Access switch
    {
        RegistrationAccess.Closed => "Sign-up is closed",
        RegistrationAccess.RequiresInvitation => "You need an invitation",
        _ => "This invitation link doesn't work",
    };

    private string UnavailableMessage => _eligibility?.Access switch
    {
        RegistrationAccess.Closed =>
            "This Relio instance isn't taking new accounts. If you need one, ask the person who runs it.",
        RegistrationAccess.RequiresInvitation =>
            "This Relio instance only takes new accounts by invitation. Ask the person who runs it to send you one.",
        _ => "It may have expired or already been used. Ask the person who invited you for a new one.",
    };

    private async Task RegisterAsync()
    {
        var result = await RegistrationService.RegisterAsync(
            new RegisterAccountRequest(Input!.Email, Input.Password, Input.TimeZoneId, InvitationToken));

        switch (result.Status)
        {
            case RegisterAccountStatus.Succeeded:
                break;

            case RegisterAccountStatus.IdentityErrors:
                _errorMessage = result.Errors.Any(e => e.Code is "DuplicateUserName" or "DuplicateEmail")
                    ? "An account with this email already exists. Try signing in instead."
                    : string.Join(" ", result.Errors.Select(e => e.Description));
                return;

            case RegisterAccountStatus.InvitationEmailMismatch:
                _errorMessage = "This invitation is for a different email address. Use the address it was sent to.";
                return;

            default:
                // The rules changed, or a crafted post skipped the form: show the matching
                // explanation instead (and no form).
                await RefreshEligibilityAsync();
                return;
        }

        Logger.LogInformation("A new account was registered.");

        var user = await UserManager.FindByIdAsync(result.UserId!);
        if (user is null)
        {
            _errorMessage = "Your account was created, but Relio couldn't sign you in. Try signing in.";
            return;
        }

        if (UserManager.Options.SignIn.RequireConfirmedAccount)
        {
            var userId = await UserManager.GetUserIdAsync(user);
            var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

            var confirmationUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("/Account/ConfirmEmail").ToString(),
                new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });

            await EmailSender.SendConfirmationLinkAsync(user, Input.Email, confirmationUrl);

            NavigationManager.NavigateTo("/Account/RegisterConfirmation?requiresConfirmation=true", forceLoad: true);
        }
        else
        {
            await SignInManager.SignInAsync(user, isPersistent: false);
            NavigationManager.NavigateTo("/onboarding", forceLoad: true);
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a password.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        /// <summary>The browser's IANA time zone id, filled by the hidden script above.</summary>
        public string TimeZoneId { get; set; } = TimeZoneIds.Default;

        /// <summary>The invitation token from the link, carried through the post in a hidden field.</summary>
        public string? InvitationToken { get; set; }
    }
}
