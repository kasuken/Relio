@page "/Account/ResetPasswordConfirmation"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout Relio.Web.Components.Account.Shared.AccountLayout

<PageTitle>Password reset - Relio</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-4" data-testid="reset-password-confirmation-heading">
    Your password has been reset
</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
    You can now sign in with your new password. Any other signed-in session will be signed out the
    next time it checks in (within 30 minutes - see AGENTS.md's "Accounts and authentication"
    section on circuit revalidation).
</MudText>
<MudButton Href="/Account/Login" Variant="Variant.Filled" Color="Color.Primary"
           data-testid="reset-password-confirmation-login">
    Go to sign in
</MudButton>
