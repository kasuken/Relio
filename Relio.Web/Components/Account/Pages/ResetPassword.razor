@page "/Account/ResetPassword"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout Relio.Web.Components.Account.Shared.AccountLayout

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Relio.Data.Identity

@inject UserManager<RelioUser> UserManager
@inject NavigationManager NavigationManager
@inject ILogger<ResetPassword> Logger

<PageTitle>Reset your password - Relio</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-6">Reset your password</MudText>

@if (_invalidLink)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="reset-password-invalid">
        @InvalidLinkMessage
    </MudAlert>
    <MudLink Href="/Account/ForgotPassword" data-testid="reset-password-request-new">
        Request a new reset link
    </MudLink>
}
else
{
    <EditForm Model="Input" FormName="reset-password" OnValidSubmit="ResetPasswordAsync" method="post">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="reset-password-error">@_errorMessage</MudAlert>
        }

        @* Plain HTML inputs, not MudTextField - see Register.razor's matching comment: MudBlazor's
           inputs need a live circuit to post their value, which this static SSR page does not have. *@
        <div class="rl-field">
            <label for="reset-password-new">New password</label>
            <input id="reset-password-new" name="Input.NewPassword" type="password" required
                   data-testid="reset-password-new" />
            <span class="rl-field-helper">At least 12 characters, with upper and lower case, a digit and a symbol.</span>
            <ValidationMessage For="@(() => Input.NewPassword)" />
        </div>

        <div class="rl-field">
            <label for="reset-password-confirm">Confirm new password</label>
            <input id="reset-password-confirm" name="Input.ConfirmPassword" type="password" required
                   data-testid="reset-password-confirm" />
            <ValidationMessage For="@(() => Input.ConfirmPassword)" />
        </div>

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   FullWidth="true" data-testid="reset-password-submit" Class="mt-2">
            Reset password
        </MudButton>
    </EditForm>
}

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    private bool _invalidLink;
    private string? _errorMessage;

    /// <summary>
    /// Deliberately the same calm message for a missing link, a malformed code, an unknown user
    /// id, and an expired or already-used token - see <see cref="ResetPasswordAsync"/> - never let
    /// this page distinguish "no such account" from "your link expired" (no account enumeration,
    /// same reasoning as ConfirmEmail.razor and Login.razor's InvalidCredentialsMessage).
    /// </summary>
    private const string InvalidLinkMessage = "This password reset link is invalid or has expired.";

    protected override void OnInitialized()
    {
        _invalidLink = string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Code);
    }

    private async Task ResetPasswordAsync()
    {
        var user = await UserManager.FindByIdAsync(UserId!);
        if (user is null)
        {
            _invalidLink = true;
            return;
        }

        string decodedCode;
        try
        {
            decodedCode = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code!));
        }
        catch (FormatException)
        {
            _invalidLink = true;
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, decodedCode, Input.NewPassword);
        if (!result.Succeeded)
        {
            if (result.Errors.Any(e => e.Code == "InvalidToken"))
            {
                // Covers an expired link, an already-used one (ResetPasswordAsync below rotates
                // the security stamp on success, which this token is bound to - see AGENTS.md),
                // and a tampered code - all the exact same message as a missing/malformed link.
                Logger.LogInformation(
                    "Password reset failed for user {UserId}: the reset link is invalid, expired or already used.",
                    user.Id);
                _invalidLink = true;
                return;
            }

            // A password policy failure (e.g. too short) - the link itself is still valid, so
            // show the specific, actionable error and let the user try again with the same link,
            // the same way Register.razor surfaces CreateAsync's password errors.
            Logger.LogInformation(
                "User {UserId} submitted a password that failed the password policy during reset.", user.Id);
            _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        // Issue #17: a successful reset also clears any lockout - the whole point of regaining
        // access by email is to not still be locked out afterwards. ResetPasswordAsync above
        // already rotated the security stamp (part of Identity's own password-change behaviour),
        // which both makes this link single-use (see InvalidLinkMessage's remarks) and signs out
        // every other active session at its next revalidation (RelioRevalidatingAuthenticationStateProvider,
        // within 30 minutes - see AGENTS.md "Accounts and authentication").
        await UserManager.ResetAccessFailedCountAsync(user);
        await UserManager.SetLockoutEndDateAsync(user, lockoutEnd: null);

        Logger.LogInformation("User {UserId} reset their password.", user.Id);
        NavigationManager.NavigateTo("/Account/ResetPasswordConfirmation", forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter a new password.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The password and confirmation do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
