@page "/Account/Manage/ResetAuthenticator"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout Relio.Web.Components.Account.Shared.AccountLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Relio.Data.Identity

@inject UserManager<RelioUser> UserManager
@inject SignInManager<RelioUser> SignInManager
@inject NavigationManager NavigationManager
@inject ILogger<ResetAuthenticator> Logger

@* Switching to a different authenticator app (issue #20), after confirming the current password.
   Deliberately "turn off, then set up again" rather than "swap the key in place": two-factor
   authentication stays off until the new app has proved it works (EnableAuthenticator.razor), so a
   half-finished switch can never leave an account that asks for codes nobody can produce. *@

<PageTitle>Set up a different authenticator app - Relio</PageTitle>

@if (_user is not null)
{
    <MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-2">Set up a different authenticator app</MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
        Use this for a new phone or another authenticator app. Relio creates a new key, so codes from your
        current app stop working straight away. Two-factor authentication stays off until you finish
        setting up the new app, and other devices signed in to your account are signed out.
    </MudText>

    <EditForm Model="Input" FormName="reset-authenticator" OnValidSubmit="ResetAsync" method="post">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="manage-2fa-error">@_errorMessage</MudAlert>
        }

        @* Plain HTML input, not MudTextField - see Register.razor's matching comment. *@
        <div class="rl-field">
            <label for="manage-2fa-reset-password">Current password</label>
            <input id="manage-2fa-reset-password" name="Input.CurrentPassword" type="password" required
                   autocomplete="current-password" data-testid="manage-2fa-reset-password" />
            <ValidationMessage For="@(() => Input!.CurrentPassword)" />
        </div>

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Error"
                   FullWidth="true" data-testid="manage-2fa-reset-submit" Class="mt-2">
            Reset and set up again
        </MudButton>
    </EditForm>

    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-6">
        <MudLink Href="/Account/Manage/TwoFactorAuthentication" data-testid="manage-2fa-back">Back to two-factor authentication</MudLink>
    </MudText>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    private RelioUser? _user;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _user = await UserManager.GetUserAsync(HttpContext.User);
        if (_user is null)
        {
            // A valid cookie for an account that no longer exists: end the session instead of
            // rendering a form that could never succeed.
            await SignInManager.SignOutAsync();
            NavigationManager.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        if (!await UserManager.GetTwoFactorEnabledAsync(_user))
        {
            // Already off: the setup page creates a fresh key on its own.
            _user = null;
            NavigationManager.NavigateTo("/Account/Manage/EnableAuthenticator", forceLoad: true);
        }
    }

    private async Task ResetAsync()
    {
        if (_user is null)
        {
            return;
        }

        if (!await UserManager.CheckPasswordAsync(_user, Input!.CurrentPassword))
        {
            Logger.LogInformation(
                "User {UserId} submitted an incorrect current password when changing two-factor settings.", _user.Id);
            _errorMessage = "Your current password is incorrect.";
            return;
        }

        var result = await UserManager.TurnOffTwoFactorAsync(_user);
        if (!result.Succeeded)
        {
            Logger.LogError("The authenticator key could not be reset for user {UserId}.", _user.Id);
            _errorMessage = "The authenticator app couldn't be reset. Try again.";
            return;
        }

        // The security stamp rotated: re-issue this session's cookie (see Disable2fa.razor).
        await SignInManager.RefreshSignInAsync(_user);

        Logger.LogInformation("User {UserId} reset their authenticator key.", _user.Id);
        NavigationManager.NavigateTo("/Account/Manage/EnableAuthenticator?status=reset", forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string CurrentPassword { get; set; } = string.Empty;
    }
}
