@page "/Account/Manage/ChangePassword"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout Relio.Web.Components.Account.Shared.AccountLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Relio.Data.Identity

@inject UserManager<RelioUser> UserManager
@inject SignInManager<RelioUser> SignInManager
@inject NavigationManager NavigationManager
@inject ILogger<ChangePassword> Logger

<PageTitle>Change your password - Relio</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-2">Change your password</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
    You'll stay signed in on this device. Any other device signed in to your account is signed out.
</MudText>

@if (Status == "changed")
{
    <MudAlert Severity="Severity.Success" Class="mb-4" data-testid="manage-password-status">
        Your password has been changed. Other devices signed in to your account will be signed out.
    </MudAlert>
}

<EditForm Model="Input" FormName="change-password" OnValidSubmit="ChangePasswordAsync" method="post">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="manage-password-error">@_errorMessage</MudAlert>
    }

    @* Plain HTML inputs, not MudTextField - see Register.razor's matching comment: MudBlazor's
       inputs need a live circuit to post their value, which this static SSR page does not have. *@
    <div class="rl-field">
        <label for="manage-password-current">Current password</label>
        <input id="manage-password-current" name="Input.CurrentPassword" type="password" required
               autocomplete="current-password" data-testid="manage-password-current" />
        <ValidationMessage For="@(() => Input!.CurrentPassword)" />
    </div>

    <div class="rl-field">
        <label for="manage-password-new">New password</label>
        <input id="manage-password-new" name="Input.NewPassword" type="password" required
               autocomplete="new-password" data-testid="manage-password-new" />
        <span class="rl-field-helper">At least 12 characters, with upper and lower case, a digit and a symbol.</span>
        <ValidationMessage For="@(() => Input!.NewPassword)" />
    </div>

    <div class="rl-field">
        <label for="manage-password-confirm">Confirm new password</label>
        <input id="manage-password-confirm" name="Input.ConfirmPassword" type="password" required
               autocomplete="new-password" data-testid="manage-password-confirm" />
        <ValidationMessage For="@(() => Input!.ConfirmPassword)" />
    </div>

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
               FullWidth="true" data-testid="manage-password-submit" Class="mt-2">
        Change password
    </MudButton>
</EditForm>

<MudText Typo="Typo.body2" Class="mud-text-secondary mt-6">
    <MudLink Href="/settings" data-testid="manage-back-to-settings">Back to settings</MudLink>
</MudText>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? Status { get; set; }

    private RelioUser? _user;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _user = await UserManager.GetUserAsync(HttpContext.User);
        if (_user is null)
        {
            // A valid cookie for an account that no longer exists: end the session instead of
            // rendering a form that could never succeed.
            await SignInManager.SignOutAsync();
            NavigationManager.NavigateTo("/Account/Login", forceLoad: true);
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (_user is null)
        {
            return;
        }

        var result = await UserManager.ChangePasswordAsync(_user, Input!.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            if (result.Errors.Any(e => e.Code == "PasswordMismatch"))
            {
                Logger.LogInformation(
                    "User {UserId} submitted an incorrect current password when changing their password.", _user.Id);
                _errorMessage = "Your current password is incorrect.";
            }
            else
            {
                // A password policy failure (e.g. too short) - same specific, actionable errors
                // Register.razor surfaces.
                Logger.LogInformation(
                    "User {UserId} submitted a new password that failed the password policy.", _user.Id);
                _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            }

            return;
        }

        // ChangePasswordAsync rotated the security stamp, which signs out every *other* session at
        // its next revalidation. This session's cookie carries the old stamp, so re-issue it -
        // otherwise the user who just changed their password would be signed out themselves.
        await SignInManager.RefreshSignInAsync(_user);

        Logger.LogInformation("User {UserId} changed their password.", _user.Id);
        NavigationManager.NavigateTo("/Account/Manage/ChangePassword?status=changed", forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a new password.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The password and confirmation do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
