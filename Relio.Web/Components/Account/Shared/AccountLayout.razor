@* Minimal shell for account pages - the anonymous ones (register, login, confirmation, etc.) and the
   signed-in Manage pages (change password, change email, two-factor authentication) - no nav
   drawer, no app bar: someone who is not signed in has nothing in Relio to navigate to yet, and the
   Manage pages are single focused forms that link back to /settings.
   Follows docs/design-system/README.md: paper ground, a single reading column, no shadows. *@
@inherits LayoutComponentBase

<MudThemeProvider Theme="RelioTheme.Theme" />
<MudPopoverProvider />
<MudSnackbarProvider />

<div class="rl-app">
    <MudContainer MaxWidth="MaxWidth.Small" Class="py-12">
        <MudText Typo="Typo.h4" HtmlTag="span" Class="rl-wordmark d-block mb-8">Relio</MudText>
        @Body
    </MudContainer>
</div>
