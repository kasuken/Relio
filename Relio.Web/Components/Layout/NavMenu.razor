@using Microsoft.Extensions.Options
@using Relio.Application.Metrics
@inject IOptionsMonitor<ProductMetricsOptions> MetricsOptions

@* The drawer's primary navigation. Icons are the fixed meanings from
   docs/design-system/README.md (Iconography): People, Reminders and Difficult moment. *@

<MudNavMenu Color="Color.Primary">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">Dashboard</MudNavLink>
    <MudNavLink Href="/people" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Group">People</MudNavLink>
    <MudNavLink Href="/reminders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.NotificationsNone">Reminders</MudNavLink>
    <MudNavLink Href="/difficult-moments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Thunderstorm">Difficult moments</MudNavLink>
    <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Settings">Settings</MudNavLink>
    @* Instance administration (#19): only administrators see it. A UI gate - the page and
       IUserAdministrationService each enforce the role themselves. *@
    <AuthorizeView Policy="@RelioPolicies.Administrator">
        <Authorized>
            <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.AdminPanelSettings">Administration</MudNavLink>
            @if (MetricsOptions.CurrentValue.Enabled)
            {
                <MudNavLink Href="/admin/metrics" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.BarChart">Product metrics</MudNavLink>
            }
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
