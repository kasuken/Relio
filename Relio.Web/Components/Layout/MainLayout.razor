@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeModeState ThemeState
@inject IJSRuntime JS
@using Relio.Web.Components.Account.Shared

<MudThemeProvider @ref="_themeProvider" Theme="RelioTheme.Theme" IsDarkMode="ThemeState.IsDark" />
<AccountSessionBoundary />

<div class="rl-app">
    <a href="#main-content" class="rl-skip-link"
       @onclick="FocusMainContentAsync" @onclick:preventDefault="true">Skip to main content</a>
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="0" Dense="false">
            <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           aria-label="Toggle navigation"
                           OnClick="ToggleDrawer" />
            <RelioLogo Class="rl-logo-compact" />
            <MudSpacer />
            <AuthorizeView>
                <Authorized>
                    <GlobalSearch />
                    <MudTooltip Text="Log an interaction">
                        <MudButton Href="/interactions/new"
                                   Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Outlined.Forum"
                                   Class="text-nowrap"
                                   aria-label="Log an interaction"
                                   title="Log an interaction"
                                   data-testid="appbar-log-interaction">
                            <span class="d-none d-sm-inline">Log an interaction</span>
                        </MudButton>
                    </MudTooltip>
                    <form action="Account/Logout" method="post" class="rl-signout-form">
                        <AntiforgeryToken />
                        <MudLink Href="/settings" Typo="Typo.body2" Class="mr-2"
                                 aria-label="Account settings"
                                 data-testid="signed-in-as">
                            <MudIcon Icon="@Icons.Material.Outlined.Person" Class="d-sm-none" />
                            <span class="d-none d-sm-inline">@context.User.Identity?.Name</span>
                        </MudLink>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Size="Size.Small"
                                   data-testid="sign-out">
                            Sign out
                        </MudButton>
                    </form>
                </Authorized>
            </AuthorizeView>
            <ThemeModeMenu />
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen"
                   Elevation="0"
                   Variant="DrawerVariant.Responsive"
                   Breakpoint="Breakpoint.Md"
                   ClipMode="DrawerClipMode.Always">
            <nav aria-label="Primary">
                <NavMenu />
            </nav>
        </MudDrawer>
        <MudMainContent>
            <main id="main-content" tabindex="-1" @ref="_mainContent">
                <MudContainer MaxWidth="MaxWidth.Large" Class="rl-page py-8">
                    @Body
                </MudContainer>
            </main>
        </MudMainContent>
    </MudLayout>
    <RelioPublicFooter />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider? _themeProvider;
    private ElementReference _mainContent;

    // Persistent on desktop, temporary (hamburger-toggled) on phones - DrawerVariant.Responsive
    // handles the behaviour difference; this just tracks the current open/closed state.
    private bool _drawerOpen = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null)
        {
            return;
        }

        ThemeState.Changed += OnThemeStateChanged;

        // wwwroot/js/theme.js already applied the stored (or system) preference to the
        // document before first paint, to avoid a flash of the wrong theme. This still has to
        // resolve MudBlazor's own internal palette (IsDarkMode) after the circuit connects, so
        // MudBlazor-rendered chrome can briefly show the light palette on a dark-preferring
        // browser - an unavoidable Blazor Server limitation, not a missed case.
        var systemIsDark = await _themeProvider.GetSystemDarkModeAsync();
        await ThemeState.InitializeAsync(systemIsDark);
        await _themeProvider.WatchSystemDarkModeAsync(ThemeState.SetSystemPreferenceAsync);

        // Marks <html data-app-ready="true"> once the circuit is connected and this first
        // interactive render has completed - see wwwroot/js/theme.js. Relio.Web.E2ETests waits
        // on this instead of a fixed delay, to avoid flaky "clicked before Blazor was listening"
        // failures.
        await JS.InvokeVoidAsync("Relio.app.markInteractive");

        StateHasChanged();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task FocusMainContentAsync() => await _mainContent.FocusAsync();

    private void OnThemeStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeStateChanged;
}
