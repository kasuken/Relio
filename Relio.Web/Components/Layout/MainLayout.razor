@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeModeState ThemeState
@inject IJSRuntime JS

<MudThemeProvider @ref="_themeProvider" Theme="RelioTheme.Theme" IsDarkMode="ThemeState.IsDark" />

<div class="rl-app">
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="0" Dense="false">
            <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           aria-label="Toggle navigation"
                           OnClick="ToggleDrawer" />
            <span class="rl-wordmark">Relio</span>
            <MudSpacer />
            <ThemeModeMenu />
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen"
                   Elevation="0"
                   Variant="DrawerVariant.Responsive"
                   Breakpoint="Breakpoint.Md"
                   ClipMode="DrawerClipMode.Always">
            <nav aria-label="Primary">
                <NavMenu />
            </nav>
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="rl-page py-8">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider? _themeProvider;

    // Persistent on desktop, temporary (hamburger-toggled) on phones - DrawerVariant.Responsive
    // handles the behaviour difference; this just tracks the current open/closed state.
    private bool _drawerOpen = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null)
        {
            return;
        }

        ThemeState.Changed += OnThemeStateChanged;

        // wwwroot/js/theme.js already applied the stored (or system) preference to the
        // document before first paint, to avoid a flash of the wrong theme. This still has to
        // resolve MudBlazor's own internal palette (IsDarkMode) after the circuit connects, so
        // MudBlazor-rendered chrome can briefly show the light palette on a dark-preferring
        // browser - an unavoidable Blazor Server limitation, not a missed case.
        var systemIsDark = await _themeProvider.GetSystemDarkModeAsync();
        await ThemeState.InitializeAsync(systemIsDark);
        await _themeProvider.WatchSystemDarkModeAsync(ThemeState.SetSystemPreferenceAsync);

        // Marks <html data-app-ready="true"> once the circuit is connected and this first
        // interactive render has completed - see wwwroot/js/theme.js. Relio.Web.E2ETests waits
        // on this instead of a fixed delay, to avoid flaky "clicked before Blazor was listening"
        // failures.
        await JS.InvokeVoidAsync("Relio.app.markInteractive");

        StateHasChanged();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OnThemeStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeStateChanged;
}
