@* The form for a person's profile: add a person (issue #22, no Person parameter) or edit one (issue
   #24, the Person to start from). Interactive (MudBlazor inputs bind live over the circuit, which is
   why the people pages are not static SSR like the account pages). Only the first name is required.
   The service is the authority on what is valid - this component only words the codes it reports
   (PersonFormMessages, ContactMethodFormMessages) - and it never reads the clock itself: a birthday
   in the future is rejected by the service, in the user's own time zone.

   Saving is a plain button, and the form has no submit button at all. Pressing Enter inside the tag
   or label autocompletes would otherwise submit the whole form (and Enter is how a tag is chosen);
   a form with no submit button and several text inputs is never submitted implicitly by a browser.
   The two services that fill the pickers are awaited one after the other; they run in the database
   lane either way, so a save still in flight cannot collide with them. *@
@using System.Globalization
@using Relio.Application.Ownership
@using Relio.Application.People
@using Relio.Domain

@inject IPeopleService PeopleService
@inject IRelationshipTypeService RelationshipTypeService
@inject ITagService TagService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<form class="rl-form" data-testid="person-form" novalidate @onsubmit:preventDefault>
    @if (_stale)
    {
        <MudAlert Severity="Severity.Warning" data-testid="person-form-stale">
            This profile changed in another tab or window. Reload to see the latest version, then make your changes again.
            <MudButton Variant="Variant.Outlined" OnClick="Reload" Class="mt-2" data-testid="person-form-reload">Reload</MudButton>
        </MudAlert>
    }

    <div data-testid="person-first-name-field">
        <MudTextField T="string"
                      @bind-Value="_model.FirstName"
                      Label="First name"
                      HelperText="The only thing Relio needs."
                      Required="true"
                      MaxLength="Person.FirstNameMaxLength"
                      Counter="Person.FirstNameMaxLength"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Error="@HasError(PersonFormField.FirstName)"
                      ErrorText="@ErrorFor(PersonFormField.FirstName)"
                      Class="rl-serif" />
    </div>

    <div data-testid="person-last-name-field">
        <MudTextField T="string"
                      @bind-Value="_model.LastName"
                      Label="Last name"
                      MaxLength="Person.LastNameMaxLength"
                      Counter="Person.LastNameMaxLength"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Error="@HasError(PersonFormField.LastName)"
                      ErrorText="@ErrorFor(PersonFormField.LastName)"
                      Class="rl-serif" />
    </div>

    <div data-testid="person-nickname-field">
        <MudTextField T="string"
                      @bind-Value="_model.Nickname"
                      Label="Nickname"
                      HelperText="What you call them, if it isn't their first name."
                      MaxLength="Person.NicknameMaxLength"
                      Counter="Person.NicknameMaxLength"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Error="@HasError(PersonFormField.Nickname)"
                      ErrorText="@ErrorFor(PersonFormField.Nickname)"
                      Class="rl-serif" />
    </div>

    <div data-testid="person-relationship-field">
        <MudSelect T="Guid?"
                   @bind-Value="_model.RelationshipTypeId"
                   Label="Relationship"
                   Clearable="true"
                   Variant="Variant.Outlined"
                   Disabled="@(_types.Count == 0)"
                   HelperText="@(_types.Count == 0 ? "You have no relationship types. Add them in Settings." : null)"
                   ToStringFunc="@TypeName">
            @foreach (var type in _types)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)type.Id)">@type.Name</MudSelectItem>
            }
        </MudSelect>
    </div>

    <TagPicker Available="_tags"
               Selected="_model.Tags"
               Error="@ErrorFor(PersonFormField.Tags)"
               Changed="OnTagsChanged" />

    <ContactMethodsEditor Rows="_model.ContactMethods"
                          Errors="_contactErrors"
                          GroupError="@ErrorFor(PersonFormField.ContactMethods)"
                          Changed="OnContactMethodsChanged" />

    <fieldset class="rl-fieldset" data-testid="person-birthday">
        <legend>Birthday</legend>
        <MudGrid Spacing="2">
            <MudItem xs="3">
                <div data-testid="person-birthday-day-field">
                    <MudNumericField T="int?"
                                     @bind-Value="_model.BirthdayDay"
                                     Label="Day"
                                     HideSpinButtons="true"
                                     Immediate="true"
                                     Variant="Variant.Outlined"
                                     Error="@HasError(PersonFormField.Birthday)" />
                </div>
            </MudItem>
            <MudItem xs="5">
                <div data-testid="person-birthday-month-field">
                    <MudSelect T="int?"
                               @bind-Value="_model.BirthdayMonth"
                               Label="Month"
                               Clearable="true"
                               Variant="Variant.Outlined"
                               ToStringFunc="@MonthName"
                               Error="@HasError(PersonFormField.Birthday)">
                        @foreach (var month in Months)
                        {
                            <MudSelectItem T="int?" Value="@((int?)month)">@MonthName(month)</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </MudItem>
            <MudItem xs="4">
                <div data-testid="person-birthday-year-field">
                    <MudNumericField T="int?"
                                     @bind-Value="_model.BirthdayYear"
                                     Label="Year"
                                     HideSpinButtons="true"
                                     Immediate="true"
                                     Variant="Variant.Outlined"
                                     Error="@HasError(PersonFormField.Birthday)" />
                </div>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary">Leave the year empty if you don't know it.</MudText>
        @if (HasError(PersonFormField.Birthday))
        {
            <MudText Typo="Typo.caption" HtmlTag="div" Color="Color.Error" role="alert" data-testid="person-birthday-error">
                @ErrorFor(PersonFormField.Birthday)
            </MudText>
        }
    </fieldset>

    <div data-testid="person-how-we-met-field">
        <MudTextField T="string"
                      @bind-Value="_model.HowWeMet"
                      Label="How you met"
                      HelperText="A place, a moment, who introduced you."
                      Lines="3"
                      Sizing="InputSizing.Auto"
                      MaxLength="Person.HowWeMetMaxLength"
                      Counter="Person.HowWeMetMaxLength"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Error="@HasError(PersonFormField.HowWeMet)"
                      ErrorText="@ErrorFor(PersonFormField.HowWeMet)"
                      Class="rl-serif" />
    </div>

    <div data-testid="person-details-field">
        <MudTextField T="string"
                      @bind-Value="_model.Details"
                      Label="Details"
                      HelperText="Anything that helps you remember them."
                      Lines="5"
                      Sizing="InputSizing.Auto"
                      MaxLength="Person.DetailsMaxLength"
                      Counter="Person.DetailsMaxLength"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Error="@HasError(PersonFormField.Details)"
                      ErrorText="@ErrorFor(PersonFormField.Details)"
                      Class="rl-serif" />
    </div>

    <div class="rl-form-actions">
        <MudButton ButtonType="ButtonType.Button"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   DropShadow="false"
                   Disabled="_saving"
                   OnClick="SaveAsync"
                   data-testid="person-form-save">
            @(IsEditing ? "Save changes" : "Add person")
        </MudButton>
        <MudButton Variant="Variant.Text"
                   Href="@CancelHref"
                   data-testid="person-form-cancel">
            Cancel
        </MudButton>
    </div>
</form>

@code {
    private PersonFormModel _model = new();
    private readonly Dictionary<PersonFormField, string> _errors = [];
    private Dictionary<(Guid Key, ContactMethodField Field), string> _contactErrors = [];
    private IReadOnlyList<RelationshipType> _types = [];
    private IReadOnlyList<Tag> _tags = [];
    private bool _saving;
    private bool _stale;

    // A foreach, not a for: the item content is rendered later, and a for loop variable would be 13 by then.
    private static readonly int[] Months = Enumerable.Range(1, 12).ToArray();

    /// <summary>The person to edit, as <c>IPeopleService.GetAsync</c> returned it. Null adds a new person.</summary>
    [Parameter]
    public Person? Person { get; set; }

    /// <summary>Raised with the person's id after a successful save, so the page can open the profile.</summary>
    [Parameter]
    public EventCallback<Guid> OnSaved { get; set; }

    /// <summary>Raised when an edit finds the person gone (or not the user's): the page shows its not-found panel.</summary>
    [Parameter]
    public EventCallback OnNotFound { get; set; }

    private bool IsEditing => Person is not null;

    private string CancelHref => Person is { } person ? $"/people/{person.Id}" : "/people";

    protected override void OnInitialized()
    {
        // Once: the model is the user's work in progress, so a re-render of the parent must not
        // replace it (the edit page keys the form on the person, so another person is a new form).
        _model = Person is null ? new PersonFormModel() : PersonFormModel.FromPerson(Person);
    }

    protected override async Task OnInitializedAsync()
    {
        // Read-only on purpose: prerendering runs this once for the server-rendered HTML and again
        // when the circuit connects. One after the other: the circuit's DbContext refuses two
        // queries at the same time.
        _types = await RelationshipTypeService.ListAsync();
        _tags = await TagService.ListAsync();
    }

    private bool HasError(PersonFormField field) => _errors.ContainsKey(field);

    private string? ErrorFor(PersonFormField field) => _errors.GetValueOrDefault(field);

    private string TypeName(Guid? id) =>
        _types.FirstOrDefault(t => id is Guid value && t.Id == value)?.Name ?? string.Empty;

    private static string MonthName(int? month) =>
        month is int value ? CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(value) : string.Empty;

    private void OnTagsChanged() => _errors.Remove(PersonFormField.Tags);

    private void OnContactMethodsChanged() => _errors.Remove(PersonFormField.ContactMethods);

    private void Reload() => Navigation.Refresh(forceReload: true);

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _errors.Clear();
        _contactErrors = [];
        IReadOnlyList<ContactMethodFormRow> sentRows = [];

        try
        {
            Guid savedId;
            if (Person is { } person)
            {
                var updated = await PeopleService.UpdateAsync(person.Id, _model.ToUpdateRequest(out sentRows));
                if (!updated)
                {
                    await OnNotFound.InvokeAsync();
                    return;
                }

                Snackbar.Saved("Changes saved");
                savedId = person.Id;
            }
            else
            {
                var created = await PeopleService.CreateAsync(_model.ToCreateRequest(out sentRows));
                Snackbar.Saved("Person added");
                savedId = created.Id;
            }

            await OnSaved.InvokeAsync(savedId);
        }
        catch (PersonValidationException exception)
        {
            ShowValidation(exception, sentRows);
            if (exception.Errors.Contains(PersonValidationError.TagNameConflict))
            {
                await ReloadTagsAsync();
            }
        }
        catch (ForeignEntityNotOwnedException exception) when (exception.EntityName == ForeignEntityNames.RelationshipTypes)
        {
            // The chosen type is gone (removed in another tab, once issue #25 lets people remove them).
            Snackbar.Problem("That relationship type is no longer available. Choose another one.");
            _model.RelationshipTypeId = null;
            _types = await RelationshipTypeService.ListAsync();
        }
        catch (ForeignEntityNotOwnedException exception) when (exception.EntityName == ForeignEntityNames.Tags)
        {
            Snackbar.Problem("One of those tags was removed. Check the tags and save again.");
            await ReloadTagsAsync();
            _model.Tags.RemoveAll(tag => tag.Id is Guid id && _tags.All(available => available.Id != id));
        }
        catch (ForeignEntityNotOwnedException exception) when (exception.EntityName == ForeignEntityNames.ContactMethods)
        {
            // A contact method this form still shows was deleted elsewhere: the page is out of date,
            // and saving it would put back or lose rows without telling anyone.
            _stale = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private void ShowValidation(PersonValidationException exception, IReadOnlyList<ContactMethodFormRow> sentRows)
    {
        foreach (var error in exception.Errors)
        {
            var (field, message) = PersonFormMessages.For(error);
            _errors.TryAdd(field, message);
        }

        // The index is a position in the rows that were sent (blank new rows are left out), and a
        // row's key is what the editor shows its messages by. The first message per input wins.
        foreach (var problem in exception.ContactMethodProblems)
        {
            if (problem.Index < 0 || problem.Index >= sentRows.Count)
            {
                continue;
            }

            var row = sentRows[problem.Index];
            var (field, message) = ContactMethodFormMessages.For(problem.Error, row.Kind);
            _contactErrors.TryAdd((row.Key, field), message);
        }
    }

    private async Task ReloadTagsAsync() => _tags = await TagService.ListAsync();
}
