@page "/people/{PersonId:guid}"
@using Relio.Application.Interactions
@using Relio.Application.Notes
@using Relio.Application.People
@using Relio.Application.Time
@using Relio.Application.Timeline
@using Relio.Domain
@using Relio.Web.Time
@using Relio.Web.Components.Notes
@inject IPeopleService PeopleService
@inject IInteractionService InteractionService
@inject INoteService NoteService
@inject IUserTimeZoneService UserTimeZone
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@* The page title is generic on purpose: titles land in browser history and tab lists, and a
   person's name is private (see the gdpr-compliant skill). *@
<PageTitle>Person - Relio</PageTitle>

@if (_loaded)
{
    @if (_person is null)
    {
        @* A person that does not exist and one that belongs to someone else look exactly the same. *@
        <PersonNotFound />
    }
    else
    {
        <MudLink Href="/people" Class="mb-4 d-inline-block" data-testid="person-back">People</MudLink>

        <header class="rl-person-header">
            <MudAvatar Class="@(_person.IsArchived ? "rl-avatar rl-avatar-archived" : "rl-avatar")" Size="Size.Large" aria-hidden="true">@PersonInitials.For(_person.FirstName, _person.LastName)</MudAvatar>
            <div class="rl-person-header-text">
                <MudText Typo="Typo.h1" HtmlTag="h1" data-testid="person-name">@_person.DisplayName</MudText>
                @if (_person.RelationshipType is not null)
                {
                    <span class="rl-meta" data-testid="person-relationship">@_person.RelationshipType.Name</span>
                }
            </div>
            <div class="rl-person-header-actions" data-testid="person-actions">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.Edit"
                           Href="@($"/people/{_person.Id}/edit")"
                           data-testid="person-edit">
                    Edit
                </MudButton>
                @* A labelled menu through MudMenu's own Label/EndIcon, not an <ActivatorContent> around a
                   separate button: that two-element activator never opened in a real browser (see
                   ThemeModeMenu.razor). Archive and restore are reversible and ask nothing; delete asks. *@
                <MudMenu Label="More"
                         EndIcon="@Icons.Material.Outlined.ExpandMore"
                         Variant="Variant.Outlined"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Disabled="_busy"
                         data-testid="person-actions-menu">
                    @if (_person.IsArchived)
                    {
                        <MudMenuItem Icon="@Icons.Material.Outlined.Unarchive" OnClick="RestoreAsync" data-testid="person-restore-menu">Restore</MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Outlined.Inventory2" OnClick="ArchiveAsync" data-testid="person-archive">Archive</MudMenuItem>
                    }
                    @* A link, not a handler: the merge page does its own work (issue #28). *@
                    <MudMenuItem Icon="@Icons.Material.Outlined.CallMerge" Href="@($"/people/{_person.Id}/merge")" data-testid="person-merge">Merge with…</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Outlined.DeleteOutline" OnClick="DeleteAsync" data-testid="person-delete">Delete</MudMenuItem>
                </MudMenu>
            </div>
        </header>

        @if (_person.IsArchived)
        {
            @* A quiet note, not an alert: archiving is calm and reversible. No live region and no
               heading (the page has exactly one h1). *@
            <div class="rl-archived-note" data-testid="person-archived">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" aria-hidden="true" />
                <div class="rl-archived-note-text">
                    <p class="rl-archived-note-title" data-testid="person-archived-date">@_archivedText</p>
                    <p class="rl-meta">@PersonArchiveText.ArchivedNoteDetail</p>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Unarchive"
                           OnClick="RestoreAsync"
                           Disabled="_busy"
                           data-testid="person-restore">
                    Restore
                </MudButton>
            </div>
        }

        @if (_person.Tags.Count > 0)
        {
            @* Labels, not links: nothing here filters by a tag yet. *@
            <div class="rl-tag-list" data-testid="person-tags">
                @foreach (var tag in _person.Tags.OrderBy(tag => tag.Name, StringComparer.CurrentCultureIgnoreCase))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="rl-tag" Text="@tag.Name" data-testid="person-tag" />
                }
            </div>
        }

        <PinnedNotes @ref="_pinnedNotes"
                     PersonId="PersonId"
                     EditRequested="EditNoteAsync"
                     Changed="PinnedNotesChangedAsync" />

        <dl class="rl-facts">
            @foreach (var contactMethod in _person.ContactMethods.OrderBy(contactMethod => contactMethod.SortOrder))
            {
                var href = ContactLinks.HrefFor(contactMethod.Kind, contactMethod.Value, contactMethod.NormalizedValue);
                <div data-testid="person-contact-method">
                    <dt>
                        <MudIcon Icon="@ContactMethodDisplay.Icon(contactMethod.Kind)" Size="Size.Small" aria-hidden="true" />
                        <span data-testid="person-contact-method-heading">@ContactMethodDisplay.Heading(contactMethod.Kind, contactMethod.Label)</span>
                    </dt>
                    <dd class="rl-entry-text rl-multiline">
                        @if (href is not null)
                        {
                            @* The only href built from a contact method, and only through ContactLinks. *@
                            <a class="rl-contact-link" href="@href" data-testid="person-contact-method-link">@contactMethod.Value</a>
                        }
                        else
                        {
                            <span data-testid="person-contact-method-value">@contactMethod.Value</span>
                        }
                    </dd>
                </div>
            }
            @if (_person.Nickname is not null)
            {
                <div>
                    <dt>Nickname</dt>
                    <dd class="rl-entry-text" data-testid="person-nickname">@_person.Nickname</dd>
                </div>
            }
            @if (_person.Birthday is { } birthday)
            {
                <div>
                    <dt><MudIcon Icon="@Icons.Material.Outlined.Cake" Size="Size.Small" />Birthday</dt>
                    <dd data-testid="person-birthday">@BirthdayDisplay.Format(birthday)</dd>
                </div>
            }
            @if (_person.HowWeMet is not null)
            {
                <div>
                    <dt>How you met</dt>
                    <dd class="rl-entry-text rl-multiline" data-testid="person-how-we-met">@_person.HowWeMet</dd>
                </div>
            }
            @if (_person.Details is not null)
            {
                <div>
                    <dt>Details</dt>
                    <dd class="rl-entry-text rl-multiline" data-testid="person-details">@_person.Details</dd>
                </div>
            }
            <div>
                <dt>Last contacted</dt>
                <dd data-testid="person-last-contacted">
                    @(_person.LastContactedOn is DateOnly contacted
                        ? DateDisplay.FormatRelative(contacted, _today)
                        : PeopleListText.NotContactedYet)
                </dd>
            </div>
        </dl>

        <PersonTimeline @ref="_timeline"
                    PersonId="PersonId"
                    Busy="@(_busy || _showInteractionEditor || _showNoteEditor)"
                    EditInteractionRequested="EditInteractionAsync"
                    DeleteInteractionRequested="DeleteInteractionAsync"
                    EditNoteRequested="EditNoteAsync"
                    DeleteNoteRequested="DeleteNoteAsync" />

        <section class="rl-profile-memories" aria-label="Notes and interactions">
            <div class="rl-profile-memory-actions">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.NoteAdd"
                           OnClick="StartNote"
                           Disabled="@(_busy || _showInteractionEditor || _showNoteEditor)"
                           data-testid="person-add-note">
                    Add a note
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="rl-profile-primary-action"
                           StartIcon="@Icons.Material.Outlined.Add"
                           OnClick="StartInteraction"
                           Disabled="@(_busy || _showInteractionEditor || _showNoteEditor)"
                           data-testid="person-log-interaction">
                    Log an interaction
                </MudButton>
            </div>
            @if (_showInteractionEditor)
            {
                <InteractionEditor PersonId="PersonId"
                                   InteractionId="_interactionIdToEdit"
                                   Saved="InteractionSavedAsync"
                                   Cancelled="InteractionCancelledAsync" />
            }
            @if (_showNoteEditor)
            {
                <NoteEditor PersonId="PersonId"
                            NoteId="_noteIdToEdit"
                            Saved="NoteSavedAsync"
                            Cancelled="NoteCancelledAsync" />
            }
        </section>
    }
}

@code {
    private Person? _person;
    private bool _loaded;
    private string _archivedText = string.Empty;
    private DateOnly _today;
    private PersonTimeline? _timeline;
    private PinnedNotes? _pinnedNotes;
    private bool _showInteractionEditor;
    private Guid? _interactionIdToEdit;
    private bool _showNoteEditor;
    private Guid? _noteIdToEdit;
    private int _loadVersion;

    // True while an archive, restore or delete is in flight: a second click (or a second menu item)
    // must not start another one, and the menu and the Restore button are disabled meanwhile.
    private bool _busy;

    [Parameter]
    public Guid PersonId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // OnParametersSet, not OnInitialized: the route parameter can change while the circuit
        // keeps this component (a link from one profile to another). Read-only on purpose -
        // prerendering runs it twice.
        _loaded = false;
        var version = ++_loadVersion;
        _showInteractionEditor = false;
        _interactionIdToEdit = null;
        _showNoteEditor = false;
        _noteIdToEdit = null;
        await LoadAsync(version);
        if (version == _loadVersion)
        {
            _loaded = true;
        }
    }

    /// <summary>
    /// Reads the person again from the service - never edits the local copy, so what is shown is
    /// always what is stored - and, for an archived person, works out the archive date in the
    /// viewer's calendar. The zone and "today" are read one after the other (the circuit's one
    /// database lane would queue them anyway) and only when there is a note to show.
    /// </summary>
    private async Task LoadAsync(int version)
    {
        var personId = PersonId;
        var person = await PeopleService.GetAsync(personId);
        if (version != _loadVersion || personId != PersonId)
        {
            return;
        }

        _person = person;
        _archivedText = string.Empty;
        if (person is not null)
        {
            var zone = person.IsArchived ? await UserTimeZone.GetTimeZoneAsync() : null;
            var today = await UserTimeZone.GetTodayAsync();
            if (version != _loadVersion || personId != PersonId)
            {
                return;
            }

            _today = today;
            if (person.IsArchived)
            {
                _archivedText = PersonArchiveText.ArchivedOn(person.ArchivedAtUtc, zone!, today);
            }
        }
    }

    private async Task ArchiveAsync()
    {
        if (_busy || _person is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var archived = await PeopleService.ArchiveAsync(PersonId);
            if (!archived)
            {
                // Removed elsewhere in the meantime: the same panel as any person that isn't there.
                _person = null;
                return;
            }

            Snackbar.Info(PersonArchiveText.Archived);
            await RefreshProfileAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestoreAsync()
    {
        if (_busy || _person is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var restored = await PeopleService.RestoreAsync(PersonId);
            if (!restored)
            {
                _person = null;
                return;
            }

            Snackbar.Info(PersonArchiveText.Restored);
            await RefreshProfileAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_busy || _person is null)
        {
            return;
        }

        _busy = true;
        try
        {
            // The one place a name appears outside the profile itself: the dialog has to be
            // unmistakable about who goes. Nothing is deleted until "Delete permanently".
            var confirmed = await DialogService.ShowConfirmAsync(
                PersonArchiveText.DeleteTitle(_person.DisplayName),
                PersonArchiveText.DeleteMessage,
                confirmLabel: PersonArchiveText.DeleteConfirmLabel,
                cancelLabel: "Cancel",
                destructive: true);
            if (!confirmed)
            {
                return;
            }

            var deleted = await PeopleService.DeleteAsync(PersonId);
            if (!deleted)
            {
                _person = null;
                return;
            }

            Snackbar.Info(PersonArchiveText.Deleted);

            // replace: true takes this profile out of the history, so Back from the list never lands
            // on the "isn't in your list" panel for someone just deleted. The one deliberate exception
            // to the list's rule that navigation pushes (the list's own view changes still push).
            // Nothing here touches state afterwards: the page is going away.
            Navigation.NavigateTo("/people", replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartInteraction()
    {
        if (_busy || _showInteractionEditor || _showNoteEditor)
        {
            return;
        }

        _interactionIdToEdit = null;
        _showInteractionEditor = true;
    }

    private void StartNote()
    {
        if (_busy || _showInteractionEditor || _showNoteEditor)
        {
            return;
        }

        _noteIdToEdit = null;
        _showNoteEditor = true;
    }

    private Task EditInteractionAsync(Guid interactionId)
    {
        if (!_busy && !_showNoteEditor)
        {
            _interactionIdToEdit = interactionId;
            _showInteractionEditor = true;
        }

        return Task.CompletedTask;
    }

    private async Task InteractionSavedAsync()
    {
        _showInteractionEditor = false;
        _interactionIdToEdit = null;
        Snackbar.Saved("Interaction saved");
        await RefreshProfileAsync();
    }

    private Task InteractionCancelledAsync()
    {
        _showInteractionEditor = false;
        _interactionIdToEdit = null;
        return Task.CompletedTask;
    }

    private Task EditNoteAsync(Guid noteId)
    {
        if (!_busy && !_showInteractionEditor)
        {
            _noteIdToEdit = noteId;
            _showNoteEditor = true;
        }

        return Task.CompletedTask;
    }

    private async Task NoteSavedAsync()
    {
        _showNoteEditor = false;
        _noteIdToEdit = null;
        await RefreshProfileAsync();
    }

    private Task NoteCancelledAsync()
    {
        _showNoteEditor = false;
        _noteIdToEdit = null;
        return Task.CompletedTask;
    }

    private Task PinnedNotesChangedAsync() =>
        _timeline?.ReloadAsync() ?? Task.CompletedTask;

    private async Task DeleteNoteAsync(Guid noteId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var confirmed = await DialogService.ShowConfirmAsync(
                "Delete this note?",
                "This note will be permanently removed. It can't be undone.",
                confirmLabel: "Delete permanently",
                cancelLabel: "Cancel",
                destructive: true);
            if (!confirmed)
            {
                return;
            }

            bool deleted;
            try
            {
                deleted = await NoteService.DeleteAsync(noteId);
            }
            catch (Exception)
            {
                Snackbar.Add("The note couldn't be deleted. Try again.", Severity.Error);
                return;
            }

            if (deleted)
            {
                Snackbar.Info("Note deleted");
            }
            else
            {
                Snackbar.Info("This note is no longer available.");
            }

            await RefreshProfileAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteInteractionAsync(Guid interactionId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var confirmed = await DialogService.ShowConfirmAsync(
                "Delete this interaction?",
                "It will be removed from every profile listed. This can't be undone.",
                confirmLabel: "Delete permanently",
                cancelLabel: "Cancel",
                destructive: true);
            if (!confirmed)
            {
                return;
            }

            bool deleted;
            try
            {
                deleted = await InteractionService.DeleteAsync(interactionId);
            }
            catch (Exception)
            {
                Snackbar.Add("The interaction couldn't be deleted. Try again.", Severity.Error);
                return;
            }

            if (deleted)
            {
                Snackbar.Info("Interaction deleted");
            }
            else
            {
                Snackbar.Info("This interaction is no longer available.");
            }

            await RefreshProfileAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshProfileAsync()
    {
        var version = ++_loadVersion;
        await LoadAsync(version);
        if (version == _loadVersion)
        {
            _loaded = true;
            if (_timeline is not null)
            {
                await _timeline.ReloadAsync();
            }

            if (_pinnedNotes is not null)
            {
                await _pinnedNotes.ReloadAsync();
            }
        }
    }
}
