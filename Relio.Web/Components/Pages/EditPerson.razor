@page "/people/{PersonId:guid}/edit"
@using Relio.Application.People
@using Relio.Domain
@inject IPeopleService PeopleService
@inject NavigationManager Navigation

@* The page title is generic on purpose, like the profile's: titles land in browser history and tab
   lists, and a person's name is private (see the gdpr-compliant skill). *@
<PageTitle>Edit person - Relio</PageTitle>

@if (_loaded)
{
    @if (_person is null)
    {
        @* Same panel as the profile: a person that does not exist and one that belongs to someone
           else are indistinguishable. *@
        <PersonNotFound />
    }
    else
    {
        <MudLink Href="@($"/people/{_person.Id}")" Class="mb-4 d-inline-block" data-testid="person-edit-back">Back to profile</MudLink>

        <MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-6">Edit details</MudText>

        @* Keyed on the person: opening another person's edit page builds a fresh form (and a fresh
           model) instead of leaving the first person's half-edited values on screen. *@
        <PersonForm @key="_person.Id"
                    Person="_person"
                    OnSaved="OpenProfile"
                    OnNotFound="ShowNotFound" />
    }
}

@code {
    private Person? _person;
    private bool _loaded;

    [Parameter]
    public Guid PersonId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // OnParametersSet, not OnInitialized: the route parameter can change while the circuit keeps
        // this component. Read-only on purpose - prerendering runs it twice. Archived people can be
        // edited too: archiving hides someone from lists, it does not lock their details.
        _loaded = false;
        _person = await PeopleService.GetAsync(PersonId);
        _loaded = true;
    }

    private void OpenProfile(Guid personId) => Navigation.NavigateTo($"/people/{personId}");

    private void ShowNotFound() => _person = null;
}
