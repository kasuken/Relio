@page "/reminders"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Relio.Application.Reminders
@using Relio.Application.Time
@using Relio.Domain
@using Relio.Web.Components.Reminders
@using Relio.Web.Components.Shared
@using Relio.Web.Time
@inject IReminderService ReminderService
@inject IUserTimeZoneService UserTimeZone
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Reminders - Relio</PageTitle>

<div class="d-flex justify-space-between align-center mb-6">
    <MudText Typo="Typo.h2" HtmlTag="h1">Reminders</MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Outlined.Add"
               OnClick="AddReminderAsync"
               data-testid="add-reminder-button">
        Add reminder
    </MudButton>
</div>

@if (!_loaded)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" @bind-ActivePanelIndex="_activeTab">
        <MudTabPanel Text="@($"Active ({_activeReminders.Count})")" data-testid="reminders-tab-active">
            @if (_upcomingBirthdays.Count > 0)
            {
                <div class="mb-6" data-testid="upcoming-birthdays-section">
                    <MudText Typo="Typo.h3" HtmlTag="h2" Class="mb-3">Upcoming birthdays</MudText>
                    <div class="d-flex flex-column gap-3" data-testid="upcoming-birthdays-list">
                        @foreach (var birthday in _upcomingBirthdays)
                        {
                            <MudCard Elevation="1" Class="pa-2" data-testid="@($"birthday-card-{birthday.PersonId}")">
                                <MudCardContent Class="d-flex align-center justify-space-between pa-2">
                                    <div class="d-flex align-center gap-3">
                                        <MudIcon Icon="@Icons.Material.Outlined.Cake" Color="@(birthday.IsDue ? Color.Warning : Color.Primary)" />
                                        <div>
                                            <div class="d-flex align-center gap-2 flex-wrap">
                                                <MudLink Href="@($"/people/{birthday.PersonId}")"
                                                         Typo="Typo.h4"
                                                         Color="Color.Primary"
                                                         Class="text-decoration-none"
                                                         data-testid="@($"birthday-person-{birthday.PersonId}")">
                                                    @birthday.PersonDisplayName
                                                </MudLink>
                                                @if (birthday.TurningAge.HasValue)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" data-testid="@($"birthday-age-{birthday.PersonId}")">
                                                        Turning @birthday.TurningAge.Value
                                                    </MudChip>
                                                }
                                                @if (birthday.IsDue)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" data-testid="@($"birthday-due-{birthday.PersonId}")">
                                                        Due
                                                    </MudChip>
                                                }
                                            </div>
                                            <MudText Typo="Typo.caption"
                                                     Color="@(birthday.DaysUntilBirthday == 0 ? Color.Warning : Color.Secondary)"
                                                     Class="mt-1 font-weight-bold"
                                                     data-testid="@($"birthday-days-until-{birthday.PersonId}")">
                                                @FormatBirthdayDaysUntil(birthday)
                                            </MudText>
                                        </div>
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }
                    </div>
                </div>
            }

            @if (_activeReminders.Count == 0)
            {
                <div data-testid="reminders-empty">
                    <EmptyState Title="No active reminders"
                                Message="You're all caught up! Create a reminder to stay in touch with people you care about." />
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3" data-testid="reminders-active-list">
                    @foreach (var reminder in _activeReminders)
                    {
                        var isOverdue = reminder.EffectiveDueDate < _today;
                        var isDueToday = reminder.EffectiveDueDate == _today;

                        <MudCard Elevation="1" Class="pa-2" data-testid="@($"reminder-card-{reminder.Id}")">
                            <MudCardContent Class="d-flex align-center justify-space-between pa-2">
                                <div class="d-flex align-center gap-3">
                                    <MudIconButton Icon="@Icons.Material.Outlined.CheckCircleOutline"
                                                   Color="Color.Primary"
                                                   Size="Size.Medium"
                                                   aria-label="Mark as completed"
                                                   OnClick="() => CompleteAsync(reminder)"
                                                   data-testid="@($"reminder-complete-{reminder.Id}")" />
                                    <div>
                                        <div class="d-flex align-center gap-2 flex-wrap">
                                            <MudLink Href="@($"/people/{reminder.PersonId}")"
                                                     Typo="Typo.h4"
                                                     Color="Color.Primary"
                                                     Class="text-decoration-none"
                                                     data-testid="@($"reminder-person-{reminder.Id}")">
                                                @reminder.PersonDisplayName
                                            </MudLink>
                                            @if (reminder.Frequency != ReminderFrequency.Once)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                                    @FormatFrequency(reminder)
                                                </MudChip>
                                            }
                                            @if (reminder.SnoozedUntilDate.HasValue)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Info">
                                                    Snoozed until @reminder.SnoozedUntilDate.Value.ToString("d MMM")
                                                </MudChip>
                                            }
                                        </div>
                                        <MudText Typo="Typo.body1" Class="mt-1" data-testid="@($"reminder-title-{reminder.Id}")">
                                            @reminder.Title
                                        </MudText>
                                        <MudText Typo="Typo.caption"
                                                 Color="@(isOverdue ? Color.Error : (isDueToday ? Color.Warning : Color.Secondary))"
                                                 Class="mt-1 font-weight-bold"
                                                 data-testid="@($"reminder-due-{reminder.Id}")">
                                            @FormatDueText(reminder)
                                        </MudText>
                                    </div>
                                </div>
                                <div class="d-flex align-center gap-1">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Snooze"
                                                   Size="Size.Small"
                                                   aria-label="Snooze"
                                                   OnClick="() => SnoozeAsync(reminder)"
                                                   data-testid="@($"reminder-snooze-{reminder.Id}")" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                   Size="Size.Small"
                                                   aria-label="Edit"
                                                   OnClick="() => EditAsync(reminder)"
                                                   data-testid="@($"reminder-edit-{reminder.Id}")" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   aria-label="Delete"
                                                   OnClick="() => DeleteAsync(reminder)"
                                                   data-testid="@($"reminder-delete-{reminder.Id}")" />
                                </div>
                            </MudCardContent>
                        </MudCard>
                    }
                </div>
            }
        </MudTabPanel>

        <MudTabPanel Text="@($"Completed ({_completedReminders.Count})")" data-testid="reminders-tab-completed">
            @if (_completedReminders.Count == 0)
            {
                <div data-testid="reminders-completed-empty">
                    <EmptyState Title="No completed reminders"
                                Message="Reminders you mark complete will show up here." />
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3" data-testid="reminders-completed-list">
                    @foreach (var reminder in _completedReminders)
                    {
                        <MudCard Elevation="1" Class="pa-2" data-testid="@($"reminder-completed-card-{reminder.Id}")">
                            <MudCardContent Class="d-flex align-center justify-space-between pa-2">
                                <div class="d-flex align-center gap-3">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="text-decoration-line-through mud-text-secondary">
                                            @reminder.Title (@reminder.PersonDisplayName)
                                        </MudText>
                                        @if (reminder.CompletedAtUtc.HasValue)
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                Completed on @reminder.CompletedAtUtc.Value.ToString("d MMM yyyy")
                                            </MudText>
                                        }
                                    </div>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="() => DeleteAsync(reminder)"
                                               data-testid="@($"reminder-delete-completed-{reminder.Id}")" />
                            </MudCardContent>
                        </MudCard>
                    }
                </div>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    private bool _loaded;
    private int _activeTab;
    private DateOnly _today;
    private IReadOnlyList<ReminderDto> _activeReminders = [];
    private IReadOnlyList<ReminderDto> _completedReminders = [];
    private IReadOnlyList<BirthdayReminderDto> _upcomingBirthdays = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        _loaded = true;
    }

    private async Task LoadDataAsync()
    {
        _today = await UserTimeZone.GetTodayAsync();
        var all = await ReminderService.ListAsync(includeCompleted: true);
        _activeReminders = all.Where(r => !r.IsCompleted).ToList();
        _completedReminders = all.Where(r => r.IsCompleted).OrderByDescending(r => r.CompletedAtUtc).ToList();
        _upcomingBirthdays = await ReminderService.ListUpcomingBirthdaysAsync(30);
    }

    private async Task AddReminderAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ReminderFormDialog>("New reminder", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }

    private async Task EditAsync(ReminderDto reminder)
    {
        var parameters = new DialogParameters<ReminderFormDialog>
        {
            { x => x.ReminderId, reminder.Id },
            { x => x.PersonId, reminder.PersonId },
            { x => x.InitialTitle, reminder.Title },
            { x => x.InitialDueDate, reminder.DueDate },
            { x => x.InitialFrequency, reminder.Frequency },
            { x => x.InitialCustomIntervalMonths, reminder.CustomIntervalMonths },
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ReminderFormDialog>("Edit reminder", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }

    private async Task SnoozeAsync(ReminderDto reminder)
    {
        var parameters = new DialogParameters<SnoozeDialog>
        {
            { x => x.ReminderId, reminder.Id },
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<SnoozeDialog>("Snooze reminder", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }

    private async Task CompleteAsync(ReminderDto reminder)
    {
        var success = await ReminderService.CompleteAsync(reminder.Id);
        if (success)
        {
            var message = reminder.Frequency == ReminderFrequency.Once
                ? "Reminder completed"
                : "Reminder completed and rescheduled for next occurrence";
            Snackbar.Add(message, Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task DeleteAsync(ReminderDto reminder)
    {
        var confirmed = await DialogService.ShowConfirmAsync(
            "Delete reminder?",
            $"Delete \"{reminder.Title}\"? This cannot be undone.",
            confirmLabel: "Delete permanently",
            destructive: true);

        if (confirmed)
        {
            await ReminderService.DeleteAsync(reminder.Id);
            Snackbar.Add("Reminder deleted", Severity.Info);
            await LoadDataAsync();
        }
    }

    private string FormatDueText(ReminderDto reminder)
    {
        var targetDate = reminder.EffectiveDueDate;
        if (targetDate < _today)
        {
            var daysOverdue = _today.DayNumber - targetDate.DayNumber;
            return daysOverdue == 1 ? "Overdue (yesterday)" : $"Overdue ({daysOverdue} days ago)";
        }
        if (targetDate == _today)
        {
            return "Due today";
        }
        var daysUntil = targetDate.DayNumber - _today.DayNumber;
        if (daysUntil == 1)
        {
            return "Due tomorrow";
        }
        if (daysUntil < 7)
        {
            return $"Due in {daysUntil} days ({targetDate:ddd, d MMM})";
        }
        return $"Due on {targetDate:d MMM yyyy}";
    }

    private static string FormatFrequency(ReminderDto reminder) => reminder.Frequency switch
    {
        ReminderFrequency.Weekly => "Weekly",
        ReminderFrequency.Monthly => "Monthly",
        ReminderFrequency.EveryThreeMonths => "Every 3 months",
        ReminderFrequency.EverySixMonths => "Every 6 months",
        ReminderFrequency.Yearly => "Yearly",
        ReminderFrequency.CustomMonths => $"Every {reminder.CustomIntervalMonths} months",
        _ => string.Empty,
    };

    private static string FormatBirthdayDaysUntil(BirthdayReminderDto birthday)
    {
        if (birthday.DaysUntilBirthday == 0)
        {
            return "Birthday is today!";
        }

        if (birthday.DaysUntilBirthday == 1)
        {
            return $"Tomorrow ({birthday.BirthdayDate:d MMMM})";
        }

        return $"In {birthday.DaysUntilBirthday} days ({birthday.BirthdayDate:d MMMM})";
    }
}
