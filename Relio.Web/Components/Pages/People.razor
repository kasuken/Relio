@page "/people"
@using Relio.Application.People
@using Relio.Application.Time
@using Relio.Domain
@inject IPeopleService PeopleService
@inject ITagService TagService
@inject IRelationshipTypeService RelationshipTypeService
@inject IUserTimeZoneService TimeZoneService
@inject NavigationManager Navigation

<PageTitle>People - Relio</PageTitle>

@* Nothing is rendered until the first load has finished: a flash of "No one here yet" for someone
   who has people would be wrong, and the load is quick. The view (sort, archived, page, filters) lives in the
   address - see PeopleListQueryString - so every control below only navigates, and the list reloads
   because the address changed. *@
@if (_result is not null)
{
    @if (!_result.HasAnyone)
    {
        <div data-testid="people-empty">
            <EmptyState Title="No one here yet"
                        Message="Add the first person you want to keep in touch with."
                        ActionLabel="Add a person"
                        OnAction="AddPerson" />
            <p class="rl-empty-alt">
                <MudLink Href="/people/import" data-testid="people-empty-import">Or import people from a file</MudLink>
            </p>
            <p class="rl-empty-alt">
                <MudLink Href="/interactions/new" data-testid="people-empty-log-interaction">Log an interaction</MudLink>
            </p>
        </div>
    }
    else
    {
        <div class="rl-page-header">
            <MudText Typo="Typo.h2" HtmlTag="h1">People</MudText>
            <div class="rl-page-header-actions">
                <MudButton Variant="Variant.Outlined"
                           Href="/interactions/new"
                           StartIcon="@Icons.Material.Outlined.Forum"
                           data-testid="people-log-interaction">
                    Log an interaction
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Href="/people/import"
                           StartIcon="@Icons.Material.Outlined.UploadFile"
                           data-testid="people-import">
                    Import
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="/people/new"
                           DropShadow="false"
                           StartIcon="@Icons.Material.Outlined.PersonAdd"
                           data-testid="people-add">
                    Add a person
                </MudButton>
            </div>
        </div>

        <div class="rl-people-toolbar" data-testid="people-toolbar">
            <div class="rl-people-search" data-testid="people-search">
                <MudTextField T="string"
                              Value="_searchTerm"
                              ValueChanged="OnSearchChanged"
                              Placeholder="Search by name or nickname..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true"
                              Immediate="true"
                              DebounceInterval="300"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              aria-label="Search people"
                              data-testid="people-search-input" />
            </div>
            <div class="rl-people-filter" data-testid="people-filter-tags">
                <MudSelect T="string"
                           MultiSelection="true"
                           SelectedValues="_selectedTags"
                           SelectedValuesChanged="OnTagsChanged"
                           Label="Filter by tag"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           data-testid="people-filter-tags-select">
                    @foreach (var tag in _availableTags)
                    {
                        <MudSelectItem T="string" Value="@tag.Name">@tag.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="rl-people-filter" data-testid="people-filter-types">
                <MudSelect T="string"
                           MultiSelection="true"
                           SelectedValues="_selectedTypes"
                           SelectedValuesChanged="OnTypesChanged"
                           Label="Filter by relationship"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           data-testid="people-filter-types-select">
                    @foreach (var type in _availableRelationshipTypes)
                    {
                        <MudSelectItem T="string" Value="@type.Name">@type.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="rl-people-sort" data-testid="people-sort">
                <MudSelect T="PeopleSort"
                           Value="_shown.Sort"
                           ValueChanged="OnSortChanged"
                           Label="Sort by"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           ToStringFunc="PeopleListText.SortLabel">
                    @foreach (var sort in SortOptions)
                    {
                        <MudSelectItem T="PeopleSort" Value="sort">@PeopleListText.SortLabel(sort)</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div data-testid="people-show-archived">
                <MudSwitch T="bool"
                           Value="_shown.IncludeArchived"
                           ValueChanged="OnArchivedChanged"
                           Label="Show archived"
                           Color="Color.Primary" />
            </div>
            @if (_shown.HasFilters)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Outlined.Clear"
                           OnClick="ClearFilters"
                           data-testid="people-clear-filters">
                    Clear filters
                </MudButton>
            }
        </div>

        @if (_result.People.Items.Count == 0 && _shown.HasFilters)
        {
            <div data-testid="people-no-matches">
                <EmptyState HeadingTag="h2"
                            Title="No people found"
                            Message="Try clearing your search or filters to see more people."
                            ActionLabel="Clear filters"
                            OnAction="ClearFilters" />
            </div>
        }
        else if (_result.People.Items.Count == 0 && !_shown.IncludeArchived)
        {
            @* Everyone is archived: the default view has no one in it, and the way out is the switch. *@
            <div data-testid="people-all-archived">
                <EmptyState HeadingTag="h2"
                            Title="Everyone is archived"
                            Message="Show archived people to see them, or add someone new."
                            ActionLabel="Show archived"
                            OnAction="ShowArchived" />
            </div>
        }
        else
        {
            <p class="rl-meta" role="status" data-testid="people-count">@(_shown.HasFilters ? PeopleListText.MatchingCount(_result.People.TotalCount) : PeopleListText.Count(_result, _shown.IncludeArchived))</p>

            <ul class="rl-person-list" data-testid="people-list">
                @foreach (var person in _result.People.Items)
                {
                    <li>
                        <a class="rl-person-row" href="/people/@person.Id" data-testid="people-list-item">
                            <MudAvatar Class="@(person.IsArchived ? "rl-avatar rl-avatar-archived" : "rl-avatar")" Size="Size.Medium" aria-hidden="true">@PersonInitials.For(person.FirstName, person.LastName)</MudAvatar>
                            <span class="rl-person-row-text">
                                <span class="rl-person-row-title">
                                    <MudText Typo="Typo.h4" HtmlTag="span" data-testid="people-list-item-name">@person.DisplayName</MudText>
                                    @if (person.IsArchived)
                                    {
                                        <span class="rl-archived-label" data-testid="people-list-item-archived">
                                            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" aria-hidden="true" />Archived
                                        </span>
                                    }
                                </span>
                                <span class="rl-meta rl-person-row-meta">
                                    @if (person.RelationshipTypeName is not null)
                                    {
                                        <span data-testid="people-list-item-relationship">@person.RelationshipTypeName</span>
                                        <span class="rl-sep" aria-hidden="true">·</span>
                                    }
                                    <span data-testid="people-list-item-last-contacted">@PeopleListText.LastContacted(person.LastContactedOn, _today)</span>
                                </span>
                            </span>
                        </a>
                    </li>
                }
            </ul>

            @if (_result.People.PageCount > 1)
            {
                <nav class="rl-people-pagination" aria-label="People pages" data-testid="people-pagination">
                    <MudPagination Count="_result.People.PageCount"
                                   Selected="_result.People.Page"
                                   SelectedChanged="OnPageChanged"
                                   Color="Color.Primary"
                                   Variant="Variant.Text"
                                   DropShadow="false"
                                   BoundaryCount="1"
                                   MiddleCount="1"
                                   ShowFirstButton="false"
                                   ShowLastButton="false" />
                </nav>
            }
        }
    }
}

@code {
    private static readonly PeopleSort[] SortOptions = [PeopleSort.Name, PeopleSort.RecentlyAdded, PeopleSort.LastContacted];

    [SupplyParameterFromQuery(Name = PeopleListQueryString.SortParameter)]
    private string? SortValue { get; set; }

    [SupplyParameterFromQuery(Name = PeopleListQueryString.ArchivedParameter)]
    private string? ArchivedValue { get; set; }

    [SupplyParameterFromQuery(Name = PeopleListQueryString.PageParameter)]
    private string? PageValue { get; set; }

    [SupplyParameterFromQuery(Name = PeopleListQueryString.SearchParameter)]
    private string? SearchValue { get; set; }

    [SupplyParameterFromQuery(Name = PeopleListQueryString.TagParameter)]
    private string[]? TagValues { get; set; }

    [SupplyParameterFromQuery(Name = PeopleListQueryString.TypeParameter)]
    private string[]? TypeValues { get; set; }

    private PeopleListResult? _result;
    private DateOnly _today;

    private IReadOnlyList<Tag> _availableTags = [];
    private IReadOnlyList<RelationshipType> _availableRelationshipTypes = [];

    private string? _searchTerm;
    private IReadOnlyCollection<string> _selectedTags = [];
    private IReadOnlyCollection<string> _selectedTypes = [];

    private PeopleListQuery _shown = new();
    private PeopleListQuery? _requestedQuery;

    private readonly SemaphoreSlim _loadGate = new(1, 1);
    private int _loadVersion;

    protected override async Task OnInitializedAsync()
    {
        _availableRelationshipTypes = await RelationshipTypeService.ListAsync();
        _availableTags = await TagService.ListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var query = PeopleListQueryString.Parse(SortValue, ArchivedValue, PageValue, SearchValue, TagValues, TypeValues);
        _searchTerm = query.SearchTerm;
        _selectedTags = query.Tags;
        _selectedTypes = query.RelationshipTypes;

        if (query == _requestedQuery)
        {
            return;
        }

        _requestedQuery = query;
        var version = ++_loadVersion;
        await _loadGate.WaitAsync();
        try
        {
            if (version != _loadVersion)
            {
                return;
            }

            var today = await TimeZoneService.GetTodayAsync();
            var result = await PeopleService.ListPageAsync(query);
            if (version != _loadVersion)
            {
                return;
            }

            (_today, _result, _shown) = (today, result, query);
        }
        finally
        {
            _loadGate.Release();
        }
    }

    private void OnSearchChanged(string? term) =>
        GoTo(CurrentQuery with { SearchTerm = string.IsNullOrWhiteSpace(term) ? null : term, Page = 1 });

    private void OnTagsChanged(IReadOnlyCollection<string> tags) =>
        GoTo(CurrentQuery with { Tags = tags.ToList(), Page = 1 });

    private void OnTypesChanged(IReadOnlyCollection<string> types) =>
        GoTo(CurrentQuery with { RelationshipTypes = types.ToList(), Page = 1 });

    private void ClearFilters() =>
        GoTo(CurrentQuery with { SearchTerm = null, Tags = [], RelationshipTypes = [], Page = 1 });

    private void OnSortChanged(PeopleSort sort) =>
        GoTo(CurrentQuery with { Sort = sort, Page = 1 });

    private void OnArchivedChanged(bool includeArchived) =>
        GoTo(CurrentQuery with { IncludeArchived = includeArchived, Page = 1 });

    private void OnPageChanged(int page) =>
        GoTo(CurrentQuery with { Page = page });

    private void ShowArchived() => OnArchivedChanged(true);

    private PeopleListQuery CurrentQuery => PeopleListQueryString.Parse(SortValue, ArchivedValue, PageValue, SearchValue, TagValues, TypeValues);

    private void GoTo(PeopleListQuery query) =>
        Navigation.NavigateTo(PeopleListQueryString.ToRelativeUri(query));

    private void AddPerson() => Navigation.NavigateTo("/people/new");
}
