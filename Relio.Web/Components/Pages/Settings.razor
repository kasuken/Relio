@page "/settings"
@using Relio.Application.Billing
@using Relio.Web.Components.Billing
@inject IBillingProvider BillingProvider

<PageTitle>Settings - Relio</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1" Class="mb-6">Settings</MudText>

@* Hosted billing only. IsEnabled is configuration, not a data call: the plan page owns the data. *@
@if (BillingProvider.IsEnabled)
{
    <MudText Typo="Typo.h3" HtmlTag="h2" Class="mb-2">Plan and billing</MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
        See your plan, subscribe to Relio Pro, or manage your billing details and invoices.
    </MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@PlanText.PlanPagePath"
               Class="mb-8" data-testid="settings-plan-link">
        View plan and billing
    </MudButton>
}

<MudText Typo="Typo.h3" HtmlTag="h2" Class="mb-2">Profile</MudText>
<DisplayNameSettings />

<MudText Typo="Typo.h3" HtmlTag="h2" Class="mt-8 mb-2">Time zone</MudText>
<TimeZoneSettings />

@* No data calls here: the two sub-pages own them (the sibling components on this page share one
   database operation at a time per circuit). *@
<MudText Typo="Typo.h3" HtmlTag="h2" Class="mt-8 mb-2">Relationship types and tags</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
    Rename, add or remove the relationship types and tags you use for people.
</MudText>
<div class="d-flex flex-wrap gap-2">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/settings/relationship-types"
               data-testid="settings-relationship-types-link">
        Manage relationship types
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/settings/tags"
               data-testid="settings-tags-link">
        Manage tags
    </MudButton>
</div>

<MudText Typo="Typo.h3" HtmlTag="h2" Class="mt-8 mb-2">Sign-in and security</MudText>
<SignInSecuritySettings />

<MudText Typo="Typo.h3" HtmlTag="h2" Class="mt-8 mb-2">Your data</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
    Download your private data or restore a complete export into a fresh account.
</MudText>
<MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/settings/data"
           data-testid="settings-data-link">
    Export or restore your data
</MudButton>
<MudButton Variant="Variant.Outlined" Href="/Account/Manage/DeleteAccount"
           Class="ml-2" data-testid="settings-delete-account-link">
    Delete your account
</MudButton>

<MudText Typo="Typo.h3" HtmlTag="h2" Class="mt-8 mb-2">Reminder emails</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
    Choose which reminders Relio emails you. This arrives with email reminders.
</MudText>
<MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/settings/reminders"
           data-testid="settings-reminder-email-preferences">
    Reminder email preferences
</MudButton>

<MudText Typo="Typo.h3" HtmlTag="h2" Class="mt-8 mb-2">Appearance</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
    Relio follows your system's light and dark setting by default. Choose System, Light or Dark
    to set it for this browser instead.
</MudText>
<ThemeModePicker />
