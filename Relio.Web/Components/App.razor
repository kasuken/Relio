@using Relio.Web.Security
@using Microsoft.AspNetCore.Components.Endpoints
@using Relio.Web.Components.Marketing
@using Relio.Web.Configuration
@inject Microsoft.Extensions.Options.IOptions<SeoOptions> SeoOptions
@inject Microsoft.Extensions.Options.IOptions<HostedPoliciesOptions> PolicyOptions
@inject IHostEnvironment HostEnvironment

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="@Assets["favicon.ico"]" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="@Assets["img/brand/icon-192.png"]" sizes="192x192" />
    <link rel="apple-touch-icon" href="@Assets["img/brand/apple-touch-icon.png"]" />
    @if (!CanIndexPage)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <ResourcePreloader />
    <!--
        Applies the stored (or system) light/dark preference before first paint, to avoid a
        flash of the wrong theme. See wwwroot/js/theme.js and Relio.Web/Theme/ThemeModeState.cs.
    -->
    <script src="@Assets["js/theme.js"]" nonce="@ContentSecurityPolicyNonce.Get(HttpContext)"></script>
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Relio.Web.styles.css"]" />
    @if (IsMarketingPage)
    {
        <link rel="stylesheet" href="@Assets["marketing.css"]" />
    }
    <ImportMap nonce="@ContentSecurityPolicyNonce.Get(HttpContext)" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Pages marked [ExcludeFromInteractiveRouting] (account and marketing pages) render as plain static
    // SSR so SignInManager/UserManager can write the auth cookie to the HTTP response. That only
    // works if the router itself is not interactive for those requests: with an unconditional
    // InteractiveServer render mode, the circuit that starts after the page loads can not find the
    // excluded page in its route table and replaces it with the Not Found page. See the "Why static
    // SSR" bullet of AGENTS.md "Accounts and authentication".
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    private bool IsMarketingPage =>
        HttpContext.GetEndpoint()?.Metadata.GetMetadata<ComponentTypeMetadata>()?.Type
            .IsDefined(typeof(MarketingPageAttribute), inherit: false) == true;

    private bool CanIndexPage => IsMarketingPage
        && HttpContext.Response.StatusCode < 400
        && HostEnvironment.IsProduction()
        && (SeoOptions.Value.IndexingEnabled
            || (PolicyOptions.Value.Enabled && PolicyOptions.Value.IndexingEnabled));
}
