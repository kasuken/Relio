{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Provider": "None"
  },
  "DemoData": {
    "Enabled": false
  },
  "Account": {
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpan": "00:15:00",
      "AllowedForNewUsers": true
    },
    "Cookie": {
      "ExpireTimeSpan": "14.00:00:00"
    },
    "Session": {
      "ValidationInterval": "00:30:00"
    }
  },
  "Registration": {
    "Mode": "Open",
    "InvitationLifetime": "7.00:00:00"
  },
  "ReminderScheduler": {
    "Enabled": true,
    "CheckInterval": "01:00:00"
  }
}
