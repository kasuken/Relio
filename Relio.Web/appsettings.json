{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "None",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.AspNetCore.Diagnostics.DeveloperExceptionPageMiddleware": "None",
      "Microsoft.AspNetCore.Components.Server": "None",
      "Microsoft.AspNetCore.SignalR": "None",
      "Microsoft.AspNetCore.Http.Connections": "None",
      "Microsoft.AspNetCore.HttpLogging": "None",
      "Microsoft.AspNetCore.Server.Kestrel": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.EntityFrameworkCore.Database.Connection": "None",
      "Microsoft.EntityFrameworkCore.Query": "None",
      "Microsoft.EntityFrameworkCore.Update": "None"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Provider": "None"
  },
  "Billing": {
    "Provider": "None"
  },
  "DemoData": {
    "Enabled": false
  },
  "HostedFeatures": {
    "ProductMetrics": {
      "Enabled": false
    },
    "Policies": {
      "Enabled": false,
      "IndexingEnabled": false
    }
  },
  "Account": {
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpan": "00:15:00",
      "AllowedForNewUsers": true
    },
    "Cookie": {
      "ExpireTimeSpan": "14.00:00:00"
    },
    "Session": {
      "ValidationInterval": "00:30:00"
    }
  },
  "Registration": {
    "Mode": "Open",
    "InvitationLifetime": "7.00:00:00"
  },
  "ReminderScheduler": {
    "Enabled": true,
    "CheckInterval": "01:00:00"
  },
  "Security": {
    "RateLimiting": {
      "Enabled": true,
      "LoginPermitLimit": 10,
      "LoginWindow": "00:01:00",
      "RegistrationPermitLimit": 5,
      "RegistrationWindow": "00:10:00",
      "PasswordResetPermitLimit": 5,
      "PasswordResetWindow": "00:10:00"
    }
  }
}
