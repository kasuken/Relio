# Relio Self-Hosted Environment Configuration
# Copy this file to .env before running docker compose:
# cp .env.example .env

# Strong SQL Server SA Password (required, must meet SQL Server complexity requirements:
# at least 8 characters with uppercase, lowercase, numbers, and symbols)
MSSQL_SA_PASSWORD=YourStrong!Passw0rdHere

# Data Protection Certificate Password (required, used to encrypt the local machine key-wrapping certificate)
RELIO_DP_PASSWORD=YourDataProtectionCertificatePassword123!

# Registration mode: Open, InviteOnly, or Closed (defaults to Open)
REGISTRATION_MODE=Open

# Email delivery: None or Smtp (defaults to None)
EMAIL_PROVIDER=None

# SMTP Configuration (only required if EMAIL_PROVIDER=Smtp)
# Email__Smtp__Host=smtp.example.com
# Email__Smtp__Port=587
# Email__Smtp__Username=your-smtp-user
# Email__Smtp__Password=your-smtp-password
# Email__Smtp__From=relio@example.com
# Email__Smtp__EnableSsl=true

# Console log format: simple (default, human-readable) or json (one JSON object per line, for log shippers)
# RELIO_LOG_FORMAT=json

# ---------------------------------------------------------------------------------------------
# Automated encrypted backups (optional): docker compose --profile backup up -d
# Full guide: docs/operations/backup-restore.md
#
# 1. Generate a key pair on ANOTHER machine, not on this server:
#      docker run --rm --entrypoint age-keygen ghcr.io/kasuken/relio-backup:latest
#    Keep the private key (AGE-SECRET-KEY-...) offline. Only the public key (age1...) goes here.
# 2. Set the public key below. Backups are encrypted to it, so this server can write backups
#    but can never read them.
# ---------------------------------------------------------------------------------------------

# Public key(s), comma separated. Required for the backup profile.
# RELIO_BACKUP_AGE_RECIPIENTS=age1...
# Public key(s) for the key-material archives; defaults to the value above.
# RELIO_KEY_BACKUP_AGE_RECIPIENTS=
# Where the encrypted archives are written on the host (two folders, two separately encrypted sets).
# RELIO_BACKUP_DIR=./backups/database
# RELIO_KEY_BACKUP_DIR=./backups/keys
# Daily backup time in UTC (HH:MM), default 02:30.
# RELIO_BACKUP_SCHEDULE_UTC=02:30
# Days to keep database backups (default 14) and key-material backups (default 90). The newest
# RELIO_BACKUP_KEEP_MIN (default 3) sets of each kind are never deleted.
# RELIO_BACKUP_RETENTION_DAYS=14
# RELIO_KEY_BACKUP_RETENTION_DAYS=90
# RELIO_BACKUP_KEEP_MIN=3
# The container reports "unhealthy" when the last backup failed or is older than this many hours.
# RELIO_BACKUP_MAX_AGE_HOURS=26
# Take a backup whenever the backup container starts (default true).
# RELIO_BACKUP_RUN_ON_START=true
# Optional URLs called with a plain GET after a successful / failed backup (for example a
# healthchecks-style monitor). They can contain a secret token, so they are never logged.
# RELIO_BACKUP_SUCCESS_URL=
# RELIO_BACKUP_FAILURE_URL=
# Optional owner of the written archives as uid:gid, so a non-root user can copy them off-site.
# RELIO_BACKUP_FILE_OWNER=
