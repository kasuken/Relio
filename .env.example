# Relio Self-Hosted Environment Configuration
# Copy this file to .env before running docker compose:
# cp .env.example .env

# Strong SQL Server SA Password (required, must meet SQL Server complexity requirements:
# at least 8 characters with uppercase, lowercase, numbers, and symbols)
MSSQL_SA_PASSWORD=YourStrong!Passw0rdHere

# Data Protection Certificate Password (required, used to encrypt the local machine key-wrapping certificate)
RELIO_DP_PASSWORD=YourDataProtectionCertificatePassword123!

# Registration mode: Open, InviteOnly, or Closed (defaults to Open)
REGISTRATION_MODE=Open

# Email delivery: None or Smtp (defaults to None)
EMAIL_PROVIDER=None

# SMTP Configuration (only required if EMAIL_PROVIDER=Smtp)
# Email__Smtp__Host=smtp.example.com
# Email__Smtp__Port=587
# Email__Smtp__Username=your-smtp-user
# Email__Smtp__Password=your-smtp-password
# Email__Smtp__From=relio@example.com
# Email__Smtp__EnableSsl=true
