* text=auto

# Import fixtures (issue #29) must stay byte-exact: line endings, trailing spaces and non-UTF-8
# encodings are part of what they test.
Relio.Application.Tests/People/Import/Fixtures/** -text -whitespace

# Shell scripts run inside Linux containers and on Linux CI runners: CRLF breaks the shebang line
# and every `$'\r'`-sensitive comparison, so they are always checked out with LF endings. The
# extensionless scripts in the backup and restore-drill folders need the directory rules.
*.sh text eol=lf
deploy/backup/* text eol=lf
deploy/restore-drill/* text eol=lf
