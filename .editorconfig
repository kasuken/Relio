root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Import fixtures (issue #29) are test data whose exact bytes matter (CRLF, folds, UTF-16, Windows-1252).
[Relio.Application.Tests/People/Import/Fixtures/**]
charset = unset
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = unset
indent_size = unset
